diff --git a/src/vessel/CachedControlMath.hpp b/src/vessel/CachedControlMath.hpp
new file mode 100644
index 00000000..fa807147
--- /dev/null
+++ b/src/vessel/CachedControlMath.hpp
@@ -0,0 +1,32 @@
+#pragma once
+#include <cmath>
+#include <limits>
+
+namespace vessel {
+
+// One-entry caches for control-rate math. Keep the original expressions and
+// recalculate on every changed input; there is no quantization or rate change.
+template <typename T>
+class CachedExp2 {
+public:
+    T get(T input) noexcept {
+        if (input != input_) { input_ = input; value_ = std::exp2(input); }
+        return value_;
+    }
+private:
+    T input_ = std::numeric_limits<T>::quiet_NaN(), value_ = 0;
+};
+
+class CachedSmoothingExponent {
+public:
+    explicit CachedSmoothingExponent(double seconds) noexcept : seconds_(seconds) {}
+    double get(double dt) noexcept {
+        if (dt != dt_) { dt_ = dt; value_ = std::expm1(-dt/seconds_); }
+        return value_;
+    }
+private:
+    const double seconds_;
+    double dt_ = -1, value_ = 0; // Callers provide nonnegative elapsed time.
+};
+
+} // namespace vessel
