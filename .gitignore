# Ignore all dotfiles except git dotfiles
.*
!.git*

# Binaries and build targets
*.a
*.so
*.dylib
*.dll
/build
/work
/dep
/dist

# Local test media and downloaded fixture sets
/tests/fixtures/*
!/tests/fixtures/tiamat/
/tests/fixtures/tiamat/*
!/tests/fixtures/tiamat/reference_v1.txt

# Durable local listening fixtures generated from the Doorstop corpus.
# Unlike build/, these are intended to survive normal build and git cleans.
/Samples/Doorstop/Auditions/
/doc/benchmarks

# Python cache artifacts
__pycache__/
*.pyc
