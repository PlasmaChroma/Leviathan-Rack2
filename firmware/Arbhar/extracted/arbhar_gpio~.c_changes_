void _stabliseADC_DuringCalibration(t_mcp_ch *s)
{
	uint16_t bufSize = s->bufCountMax;
	bufSize = bufSize > 100 ? 100 : bufSize < 1 ? 1 : bufSize;
	uint16_t bufCount = s->bufCount;
	//uint16_t freezeThresh = s->freezeThresh;
	t_float sum = 0;
	t_float check = 0;	
	check = s->raw - s->last;
	//if(s->ch == 7)
	//	post("raw: %f", s->raw);
	if(abs(check) > 700 || s->raw < 2 || s->raw > 4093)
	{
		for(int i=0;i<bufSize;i++)
			s->buf[i] = s->raw;
	} else
		s->buf[bufCount] = s->raw;
	bufCount++;
	if(bufCount >= bufSize)
		bufCount = 0;
	s->bufCount = bufCount;	
	for(int i=0;i<bufSize;i++) {
		sum += s->buf[i];
	}
	sum /= (t_float)bufSize;
	s->avg = sum;
	//if(s->ch == 7)
	//	post("avg: %f", s->avg);
	check = s->last - sum;
	if(abs(check) < 50){
		s->last = s->last + (check * -0.9);
	}
	else {
		s->last = sum;
	}

	s->val = s->last;
	//post("value for %d: %d", s->ch, s->val);
	
}

void _stabliseADC(t_mcp_ch *s)
{	uint16_t bufSize = s->bufCountMax;
	bufSize = bufSize > 100 ? 100 : bufSize < 1 ? 1 : bufSize;
	uint16_t bufCount = s->bufCount;
	uint16_t freezeThresh = s->freezeThresh;
	t_float sum = 0;
	t_float check = 0;
	t_float raw = scaleAdcToReducedRange(s->raw, s->mid, s->notch, s->lowest, s->highest);
	// if(s->ch == 3) post("ch: %d raw: %f", s->ch, raw);
	s->raw = raw;
	check = s->raw - s->last;
	//TODO: is this where to add maximum correction?
	if(abs(check) > 700 || s->raw < 2 || s->raw > 4093)
	{
		for(int i=0;i<bufSize;i++)
			s->buf[i] = s->raw;
	} else {
		if(s->raw > s->highest){
			s->buf[bufCount] = 4095;
		} else if (s->raw < s->lowest){
			s->buf[bufCount] = 0;
		} else {
			s->buf[bufCount] = s->raw;
		}
	}
	bufCount++;
	if(bufCount >= bufSize)
		bufCount = 0;
	s->bufCount = bufCount;	
	for(int i=0;i<bufSize;i++) {
		sum += s->buf[i];
	}
	sum /= (t_float)bufSize;
	s->avg = sum;
	check = s->last - sum;
	if(abs(check) < 50){
		s->last = s->last + (check * -0.9);
	}
	else {
		s->last = sum;
		//if(no == 5)
			//post("check>20");
	}
	//if(s->ch == 0 && bufCount == 0)
	//	post("checkThresh ch %d: %d", s->ch, s->freezeThresh);
	
	check = s->last - s->lastFrozen;
	if(abs(check) < freezeThresh && s->freeze < 1) {
		s->freezeCount++;
		//if(s->ch == 0)
			//post("count++, %d", s->freezeCount);
		if(s->freezeCount > s->freezeCountMax){
			s->freeze = 1;
			s->lastFrozen = s->last;
			//if(s->ch == 0)
			  //post("frozen %f", check);
		}
	}
	else if(abs(check) >= freezeThresh) {
		s->freezeCount = 0;
		s->freeze = 0;
		s->lastFrozen = s->last;
		//if(s->ch == 0)
			  //post("unfrozen %f", check);
	}
	
	if(s->freeze < 1){
		s->val = s->last; //(uint16_t)scaleToMid(s->last, s->mid, s->notch);	
	}
	else
		s->val = s->val;
	//x->x_ch[no].val = x->x_ch[no].last;
}

t_float readFromSharedMem(t_arbhar_gpio_tilde *x, t_float index)
{
    if ( !x->share_memory ) return 0.0f;
    int shmem_offset;

	shmem_offset = index;
  t_float retval;
	if (shmem_offset < 0) shmem_offset = 0;
	if (shmem_offset > x->segment_size-1) shmem_offset = x->segment_size-1;
  retval = x->share_memory[shmem_offset];
  //if(retval != 0)
	 //post("%d=%f", shmem_offset,retval);
	//outlet_float(x->x_obj.ob_outlet, x->share_memory[shmem_offset]);
  return retval;
}

void _setPlayParameters(t_arbhar_gpio_tilde *x)
{
	/* dependent on paramMode, combine SCC and SCP - done
	 * dependent on followMode, set position (SCC) and playback speed (SCP)
	 * write to shMem 61019 id 100 
	 * sharing playack speed seperately?
	 * */
	t_float bufAccessSizeInSamp = 480000;
	t_float bufAccessSizeInPerCent = 100000;  //for percentage
	static t_float mcpChSCP = 0;
	if(_getCurrentParamMode(x) <= PARAM_SHIFT)
		mcpChSCP = 4095 - x->x_ch[7].val;
	// if(x->x_paramMode == PARAM_MOMENTARY)
	 //	
	t_float mcpChSCC = (4095 - x->x_ch[2].val) - 2048;//- (4095 - x->x_ch[2].mid);
	//post("mcpChSCC: %f", mcpChSCC);
	t_float SCPSCC = mcpChSCP + mcpChSCC;
	SCPSCC = SCPSCC >= 4095 ? 4095 : SCPSCC < 0 ? 0 : SCPSCC;
	//t_float bufActualSize = 13000;
	t_float position = 0;
	if(x->x_followMode && x->x_omega == 0) {
		position = x->x_followPosition;// / 4.8f;
		
		if(x->x_followBiDirectional == 1 && x->x_followLoop == 0) {
			x->x_followBiDirectional = 0;
		}
		
		if(x->x_followPosOffsetByScanCV > 0) {
			x->x_followSpeed = calculateFollowSpeed(mcpChSCP, x->x_followBiDirectional);
			//post("follow position: %f", position);
			x->x_followPosOffset = (mcpChSCC / 2048) * bufAccessSizeInSamp;
			//post("follow position offset: %f | %f | %f", (mcpChSCC / 2048), mcpChSCC, x->x_ch[2].mid);
			position += x->x_followPosOffset;
			if(position > bufAccessSizeInSamp){
				position -= bufAccessSizeInSamp;
			} 
			else if (position < 0) {
				position += bufAccessSizeInSamp;
			}
			//post("follow position: %f", position / 4.8f);
		}
		else {
			x->x_followSpeed = calculateFollowSpeed(SCPSCC, x->x_followBiDirectional);
		}
	}
	else
		position = SCPSCC / 4095 * bufAccessSizeInSamp; //2.442002442; // 10000 / 4095  //
	//post("position %f", position);
	x->x_scanPosition = position;
	//post("position at %f %",(float)position/1000);
	//TODO: position/layer for omega:
	if(x->x_omega > 0){
		//static t_float prevOmPos = -1;
		t_float omegaPosition = SCPSCC / 4095 * bufAccessSizeInPerCent * 6;
		t_float omegaLayer = omegaPosition / bufAccessSizeInPerCent;
		omegaPosition = fmod(omegaPosition, bufAccessSizeInPerCent - 1);
		//if(prevOmPos != omegaPosition)
			//post("omega position %f  in layer %d", omegaPosition, (uint8_t)omegaLayer);
		//prevOmPos = omegaPosition;
		if((uint8_t)omegaLayer <= 5){
			//post("omega position %f  in layer %d", omegaPosition, (uint8_t)omegaLayer);
			_setPlayAndRecLayerInOmega(x, (uint8_t)omegaLayer);
			writeToSharedMem(x,SHM_POS_PERCENT,(uint32_t)omegaPosition);
		}
	} else {
		writeToSharedMem(x,SHM_POS_PERCENT,(uint32_t)(position / 4.8f));
	}
	
	
	//LENGTH
	t_float mcpChLEN = 4095 - x->x_ch[5].val;
	//t_float length = /*sr * */ mcpChLEN / 4095; //* 0.732600732; // 3000 / 4095
	t_float length = 10000;
	//TODO: Add clock devision dependent length setting
	if(x->x_internalBpmClock && x->clock_sets_length)
	{
		float bias = (mcpChLEN / 4095.f) + 0.5;
		bias = bias * bias;
		length = ((60000 / x->x_bpm) / 3000) * bufAccessSizeInPerCent;
		if(x->x_clockMultiplier != 0.f)
			length /= x->x_clockMultiplier;
		else
			length = 1000;
		length *= bias;
		//  post("bias: %f",bias) ; 
	} else 
	{
		length = _makeExponential(mcpChLEN / 4095.f) * bufAccessSizeInPerCent;
	}
	length = (length > bufAccessSizeInPerCent) ? bufAccessSizeInPerCent : length;
	// post("length at %f",length);
	writeToSharedMem(x,SHM_LENGTH_MS,(uint32_t)length);



	
	//SPRAY
	t_float mcpChSPR = 4095 - x->x_ch[12].val;
	t_float spray = _makeExponential(mcpChSPR / 4095.f) * bufAccessSizeInPerCent;
	spray = spray > bufAccessSizeInPerCent ? bufAccessSizeInPerCent : spray;
	//post("position at %f %",spray);
	writeToSharedMem(x,SHM_SPRAY,(uint32_t)spray);
}

void _getAllAdcsDuringCalibration(t_arbhar_gpio_tilde *x)
{
	//static int slowCh = 0;
	uint16_t raw = 0;
	for (uint8_t i=0; i<16; i++){
			uint8_t n = x->x_ch[i].ch;
			raw = readADC((uint8_t)(n / 8), n % 8);
			x->x_ch[i].raw = (t_float)raw;
			//arbhar_gpio_tilde_toMem(x,n,val);
			_stabliseADC_DuringCalibration(&x->x_ch[i]);
	}

}

void _getAllAdcs(t_arbhar_gpio_tilde *x)
{
	//static uint8_t frame = 0;
	//if(frame == 0) {
		static uint16_t values[16]; 
	
		uint16_t raw = 0;
		//bcm2835_spi_begin();
		//bcm2835_spi_setClockDivider(BCM2835_SPI_CLOCK_DIVIDER_128);
		//priority order ch 2,4,7,14,10,1 and 3
		for (uint8_t i=0; i<6; i++){
			uint8_t n = x->x_ch[i].ch;
			raw = readADC((uint8_t)(n / 8), n % 8);
			x->x_ch[i].raw = (t_float)raw;
			//arbhar_gpio_tilde_toMem(x,n,val);
			
			if(i == 0) {
				x->x_ch[8].raw = (t_float)readADC(0,3);
			}
		}
		static uint8_t slowCh = 0;
		//priority order ch 13,0,6,3,12,5,9,8,11,15
		uint8_t getCh = slowCh + 6;
		uint8_t m = x->x_ch[getCh].ch;
		values[getCh] = x->x_ch[getCh].val;
		raw = readADC((uint8_t)(m / 8), m % 8);
		
		x->x_ch[getCh].raw = (t_float)raw;

		//arbhar_gpio_tilde_toMem(x,m,val);
		
		_stabliseADC(&x->x_ch[getCh]);
		
		if(getCh == 6) {
			if(x->x_modToPanning > 0)
				writeToSharedMem(x,SHM_MOD_PANNING,x->x_ch[getCh].val);
			//else
			//	writeToSharedMem(x,SHM_MOD_PANNING,x->x_ch[getCh].mid);
			if(x->x_modToHold > 0)
				writeToSharedMem(x,SHM_MOD_HOLD,x->x_ch[getCh].val);
			//else
			//	writeToSharedMem(x,SHM_MOD_HOLD,x->x_ch[getCh].mid);
			if(x->x_modToReverb > 0)
				writeToSharedMem(x,SHM_MOD_REVERB,x->x_ch[getCh].val);
			//else
			//	writeToSharedMem(x,SHM_MOD_REVERB,x->x_ch[getCh].mid);
			if(x->x_modToDelay > 0)
				writeToSharedMem(x,SHM_MOD_DELAY,x->x_ch[getCh].val);
			//else
			//	writeToSharedMem(x,SHM_MOD_DELAY,x->x_ch[getCh].mid);
		}
		
		for(uint8_t i=0; i<16; i++){
			if(i < 6)
				_stabliseADC(&x->x_ch[i]);
			//uint8_t n = x->x_ch[i].ch;
			values[i] = x->x_ch[i].val;
			//writeToSharedMem(x,n,x->x_ch[i].val);
		}
		if(_getCurrentParamMode(x) != TRACK_AND_HOLD){
			writeChunkToSharedMem(x,0,values,16);
		
			_setPlayParameters(x);
			_setPlayAndRecLayer(x);
		} 
		
		
		//_stabliseADC(x,64,7);
		//writeToSharedMem(x,m,x->x_ch[getCh].val);
		if(x->x_currentOnsetMode->triggerGrain) {
			int currentTrigVal = (int)readFromSharedMem(x,SHM_TRIG_OUT_VOL);
			static int prevTrigVal = 0;
			if(currentTrigVal > prevTrigVal) {
				_setTriggerOut(1);
				prevTrigVal = currentTrigVal;
				//post("setting trugger high");
				clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
			} else {
				prevTrigVal = currentTrigVal;
			}
		} 
		//{
			//int ledState = 1 - readFromSharedMem(x,SHM_HOLD_ACTIVE);
			//if(x->x_stereo < 1)
				//ledState *= x->x_currentOnsetMode->plusLedColour;
			//_setPlusLed(ledState);
			////post("plus led state: %d",ledState);
		//}
	
		if(x->x_currentOnsetMode->triggerHold && x->x_currentOnsetMode->triggerOnset) {
			int cHoldVal = readFromSharedMem(x,SHM_HOLD_ACTIVE);
			int cDirectVal = readFromSharedMem(x,SHMEM_ONSET_FOR_TRIGGER);
			if (cHoldVal > 0 || (cDirectVal > 0 && x->x_useHoldToSwitch < 1)) {
				_setTriggerOut(1);
				//if(cDirectVal > 0)
					//post("receiving additional trigger to output");
				clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
			}
			//else
				//_setTriggerOut(0);
			writeToSharedMem(x,SHMEM_ONSET_FOR_TRIGGER,0);
		} else if(x->x_currentOnsetMode->triggerOnset && x->x_currentOnsetMode->triggerHold < 1) {
			int cDirectVal = readFromSharedMem(x,SHMEM_ONSET_FOR_TRIGGER);
			int cHoldVal = readFromSharedMem(x,SHM_HOLD_ACTIVE);
			static int pHoldVal = 0;
			if (cDirectVal > 0) {
				_setTriggerOut(1);
				//if(cDirectVal > 0)
					//post("receiving additional trigger to output");
				clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
			}
			else if (pHoldVal < cHoldVal) {
				_setTriggerOut(1);
				clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
			}
			pHoldVal = cHoldVal;
				//_setTriggerOut(0);
			writeToSharedMem(x,SHMEM_ONSET_FOR_TRIGGER,0);
		}
	
		

		
		//post("getCh: %d",getCh);
		slowCh++;
		slowCh = slowCh % 10;
		
		if(x->printMcpChValue >= 0) {
			int checkCh = (int)x->printMcpChValue;
			if(slowCh == 0){
				post("shMem slot: %d val: %d,  value: %d read from mcpCh: %d", checkCh, (int)x->x_ch[checkCh].val, values[checkCh],x->x_ch[checkCh]);
			}
		}
		
		if(slowCh == 0)
		{
			int ledState = 1 - readFromSharedMem(x,SHMEM_CURRENT_HOLD_VALUE);
			if(x->x_stereo < 1)
				ledState *= x->x_currentOnsetMode->plusLedColour;
			_setPlusLed(ledState);
			//post("plus led state: %d",ledState);
		}
}

void _setOmega(t_arbhar_gpio_tilde *x, uint8_t omega){
	//post("omega: %d", omega);
	x->x_omega = omega;
}

uint8_t _setFollowModeSwitch(t_arbhar_gpio_tilde *x, t_float val) {
	static uint8_t enable = 0;
	static uint8_t switch_state = 0;
	if(_getCurrentParamMode(x) == PARAM_MOMENTARY) {
		if(val < 3800 && val > 300)
			{
				enable = 1;
			}
		else if (val >= 3800 && enable == 1){
			switch_state = 1 - switch_state;
			enable = 0;
			if(switch_state > 0)
				changeInternalClockState(x,0, 0);
			_setFollowMode(x,switch_state);
		}
		else if (val <= 300 && enable == 1){
			switch_state = 1 - switch_state;
			enable = 0;
			if(x->x_enableClockedModeSwitch == 0)
				_setFollowMode(x,switch_state);
			else {
				switch_state = 1 - x->x_internalBpmClock;
				if(x->x_followMode > 0){
					_setFollowMode(x,0);
				}
				changeInternalClockState(x,switch_state, 0);
			}
		}
	} else {
		enable = 0;
	}
	//post("check follow switch: %f", switch_state);
	return switch_state;
	
}

void _setFollowMode(t_arbhar_gpio_tilde *x, uint8_t follow){
	//post("should try to set follow mode %f", follow);
	static uint8_t prevFollow = 255;
	uint8_t cFollow = follow;
	if(prevFollow != cFollow) {
		//post("does it set follow mode %f?", follow);
		x->x_followMode = cFollow;
		writeToSharedMem(x,SHM_FOLLOW_MODE,(int)x->x_followMode);
		if(cFollow > 0)
			x->x_followPosition = 0;

		t_atom configurationInfo[2];
		SETSYMBOL(configurationInfo, gensym("FollowMode"));
		SETFLOAT(configurationInfo+1, x->x_followMode);
		//SETFLOAT(configurationInfo+2, v);
		if(x->x_arbharMode < CALIBRATION_MODE)
			outlet_list(x->config_out, gensym("list"),2,configurationInfo);

		prevFollow = cFollow;
	}
	
}

void _setWhiteLyrLedPulse(t_arbhar_gpio_tilde *x, uint8_t val){
	static uint8_t pVal = 255;
	if(pVal != val) {
		post("led pulse = %d", val);
		t_atom ctlInfo[2];
		SETFLOAT(ctlInfo, (t_float)val);
		SETFLOAT(ctlInfo+1, 157);
		outlet_list(x->toSerial, gensym("list"),2,ctlInfo);
		pVal = val;
	}
}

t_int _controlLayerCoupling(t_arbhar_gpio_tilde *x,t_float lypVal) {
	static t_int recLayer = 0;
	//post("rec layer %d, protect layer %d", x->x_recLayer, x->x_protectPlayLayerValue);
	if(_getCurrentParamMode(x) == PARAM_SHIFT /*&& x->x_protectPlayLayerValue == 0*/){
		//post("set rec layer %f", ((((4095.f - x->x_ch[11].val) * 0.0002442) * 6.0f)+0.5));
		t_int recLayer = x->x_recLayer;
		if(x->x_playLayer != (t_int)lypVal)
			recLayer = (t_int)lypVal;
		if(x->x_playLayer != recLayer)
			recLayer = (t_int)lypVal;
		if(recLayer <= 5) {
			if(recLayer != x->x_playLayer && x->x_protectPlayLayerValue != 1){
				x->x_playRecCoupled = 0;
				x->x_protectPlayLayerValue = 1;
				_setWhiteLyrLedPulse(x,1);
				writeToSharedMem(x,SHM_REC_LYR,recLayer);
				x->x_recLayer = recLayer;
			//	post("setting recLayer %d", recLayer);
			}
		}
		if(recLayer > 5){
			x->x_playRecCoupled = 1;
			x->x_recLayer = recLayer = x->x_playLayer;
			//post("check play layer %d", recLayer);
			//writeToSharedMem(x,SHM_REC_LYR,recLayer);
		}
		if(x->x_playRecCoupled < 1 && recLayer <= 5){
			writeToSharedMem(x,SHM_REC_LYR,recLayer);
			x->x_recLayer = recLayer;
			//post("set rec layer %d", recLayer);
		}
	}
	return recLayer;
}

void _setPlayAndRecLayer(t_arbhar_gpio_tilde *x)
{
	/* dependent on paramMode, combine LYC abd LYP
	 * dependent on shift, uncouple and set rec mode
	 * write to shMem 61019 id 30 and 31
	 * */
	t_float lypVal = ((((4095.f - x->x_ch[11].val) * 0.0002442) * 6.0f)+0.5);
	
	t_int recLayer = _controlLayerCoupling(x,lypVal);
	
	//if(x->x_playRecCoupled > 0){
		static t_float lyp = 0;
		static t_float lyc = 2048;
		static int playLayer = 0;
		playLayer = x->x_playLayer;
		//static int recLayer = 0;
		//static count = 0;
		//post("line 657 mode: %d getMode: %d", x->x_paramMode, getCurrentParamMode(x));
		//if(x->x_paramMode < 1){
			//TODO: Why does this differ from ... ???  
		if(_getCurrentParamMode(x) == PERFORMANCE){
			lyp = lypVal;
			uint8_t omega = (uint8_t)lyp > 5 ? 1 : 0;
			static uint8_t prevOm = 0;
			if(prevOm != omega)
				_setOmega(x, omega);
			prevOm = omega;
			lyp = lyp >= 5 ? 5 : lyp;
		//	int val = (int)((((float)(4095 - x->x_adcValues[5]) * 0.0002442) * 6.0f)+0.5); // 0.0002442 = 1 / 4095
		} 
		if(x->x_omega < 1) {
			lyc = (((2048.f - x->x_ch[1].val) * 0.0002442) * 24.0f);
			int lycMod = ((int)lyc) % 6;
			playLayer = (int)lyp + lycMod;
			if(playLayer < 0)
				playLayer = 6 + playLayer;
			else
				playLayer = playLayer % 6;
			// if(count < 1)
			// 	post("LYP: %d + LYC: %d = playLayer %d", (int)lyp,lycMod, playLayer);
			// count++;
			// count = count < 50 ? count : 0;
			if(x->x_protectPlayLayerValue > 0 && _getCurrentParamMode(x) == PERFORMANCE){
				if(playLayer == x->x_playLayer){
					x->x_protectPlayLayerValue = 0;
					_setWhiteLyrLedPulse(x,0);
				}
			}
			//static uint8_t prevProtectStatus = 0;
		//	static uint8_t setProtectSign = 0;
			if(x->x_protectPlayLayerValue < 1){
				writeToSharedMem(x,SHM_PLY_LYR,playLayer);
				x->x_playLayer = playLayer;
				if(x->x_playRecCoupled > 0){
					writeToSharedMem(x,SHM_REC_LYR,playLayer);
					x->x_recLayer = playLayer;
				}
				//prevProtectStatus != protectPlayLayerValue && 
			}
			else if(x->x_protectPlayLayerValue > 0 && _getCurrentParamMode(x) == PERFORMANCE){
				_setWhiteLyrLedPulse(x,1);
			} 
			
		//	prevProtectStatus = x->x_protectPlayLayerValue;
			//outlet_list(x->toSerial, gensym("list"),4,ctlInfo);
		} //else {
			//_setPlayAndRecLayerInOmega(x); 
		//}
		
	//} else {
		////post("recPlayDecoupled");
	//}
	//post("recLayer %d playLayer %d", x->x_recLayer, x->x_playLayer);
}

void _setPlayAndRecLayerInOmega(t_arbhar_gpio_tilde *x, uint8_t layer)
{
	x->x_omegaPlayLayer = layer;
	
	writeToSharedMem(x,SHM_PLY_LYR,layer);
	if(x->x_playRecCoupled > 0){
		writeToSharedMem(x,SHM_REC_LYR,layer);
		//x->x_playLayer = layer;
	}
}

void _setCaptureLed(t_arbhar_gpio_tilde *x, t_float c){
	t_atom ctlInfo[2];
	SETFLOAT(ctlInfo,c);
	SETFLOAT(ctlInfo+1,144);
	outlet_list(x->g_info_out, gensym("list"),2,ctlInfo);
}

void tick_scheduleRecordingStart(t_arbhar_gpio_tilde *x){
	_toggleRecordingState(x);
}

void checkInternalClock(t_arbhar_gpio_tilde *x){
	if(x->x_internalBpmClock > 0){
		clock_delay(x->x_clockTriggeringGrains, 1000);
		clock_delay(x->x_bpmClock,1000);
	} else {
		clock_unset(x->x_clockTriggeringGrains);
		clock_unset(x->x_bpmClock);
	}
}

void changeInternalClockState(t_arbhar_gpio_tilde *x, int clocked, int time){
	static uint8_t prevClocked= 255;
	uint8_t cClocked = clocked;
	if(prevClocked != cClocked) {
		x->x_internalBpmClock = cClocked;
		writeToSharedMem(x,140,cClocked);
		t_atom configurationInfo[2];
		SETSYMBOL(configurationInfo, gensym("ClockedMode"));
		SETFLOAT(configurationInfo+1, x->x_internalBpmClock);
		if(x->x_arbharMode < CALIBRATION_MODE)
			outlet_list(x->config_out, gensym("list"),2,configurationInfo);
		prevClocked = cClocked;
	}
	if(x->x_internalBpmClock > 0){
		clock_delay(x->x_clockTriggeringGrains, time);
		clock_delay(x->x_bpmClock,time);
	} else {
		clock_unset(x->x_clockTriggeringGrains);
		clock_unset(x->x_bpmClock);
	}
}

void tick_strikeLed(t_arbhar_gpio_tilde *x){
	static t_float val = 0;
	uint8_t col = x->x_strikeColour;
	val = 1-val;
	//post("LED %f",val);
	//writeToSharedMem(x, SHM_STR_B, val > 0 ? 1 : 0);
	if(_getCurrentParamMode(x) == PERFORMANCE)
	{	
		writeToSharedMem(x, SHM_STR_B, val > 0 ? 1 : 0);
		if(val > 0){
			_setStrikeLed(x,col);
			clock_delay(x->x_strikeLed, 50);
		}
		else {
			_setStrikeLed(x,WHITE_AMBER_OFF);
		}
	}	
}

void tick_captureCvLed(t_arbhar_gpio_tilde *x) {
	_setCaptureLed(x,0);
}

void tick_clockedGrains(t_arbhar_gpio_tilde *x) {

	static t_float triggerSpeed = 1;
	static int speedId = 0;
	x->x_clockMultiplier = x->x_ch[10].val > 4000 ? 0 : 1;
	if(x->x_clockMultiplier != 0) {
		triggerSpeed = ((t_float)(2048 - x->x_ch[10].val) / 2048) * 10;
		speedId = (int)(triggerSpeed + 0.5);
		//post("triggerSpeed: %d",speedId);
		if(speedId >= 0)
			x->x_clockMultiplier = x->clockMult[speedId];
		else {
			t_float div = x->clockDiv[abs(speedId / 2)];
			if (div > 0)
				x->x_clockMultiplier = 1 / div;
		}
	}
	//post("mult: %f",x->x_clockMultiplier);

	t_float dur = 60000 / x->x_bpm;
	if (x->x_clockMultiplier == 0) {
		clock_delay(x->x_clockTriggeringGrains, dur);
		// clock_delay(x->x_strikeCvLed,0.f);
	} else {
	 	clock_delay(x->x_clockTriggeringGrains, dur / x->x_clockMultiplier);
	 	//writeToSharedMem(x,SHM_STR_CV,1); // set the flag to play a grain
		writeToSharedMem(x,SHM_CLOCKED_GRAIN, 1);
	 }
}

void tick_bpmClock(t_arbhar_gpio_tilde *x){
	static float pBpm = 120;
	static int bpmGotAdapted = 0;
	x->lastInternalClockFrame = x->x_dspFrameClock;
	int adapted = _adaptInternalBpm(x);
	if(pBpm != x->x_bpm || bpmGotAdapted != adapted)
	 	post("adapted BPM: %d : %f",adapted, x->x_bpm);
	bpmGotAdapted = adapted;
	t_float dur = 60000 / x->x_bpm;
	t_int frame = x->lastInternalClockFrame - x->lastExternalClockFrame;
	t_float timeInMs = ((float)frame * 64.f) / 48.f;
	if(timeInMs <= dur*1.1){
		//if(PRINT_CLOCK_TRIGGER_TIME_DIFF)
			// post("internal clock happened %f after external clock (clock duration %f)", timeInMs, dur);
		float diff = timeInMs / dur;
		// post("bpm factor %f", diff);
		if(timeInMs <= dur * 0.5){
			x->x_bpm *= 1. + (diff * 0.1);
		} else {
			x->x_bpm *= 1. - ((1 - diff) * 0.1);
		} /* else {
			x->x_bpm *= 1.2;
		} */
	}
	pBpm = x->x_bpm;
	static uint32_t val = 0;
	static t_float triggerSpeed = 1;
	static int speedId = 0;
	static t_float pTriggerState = 0;
	x->x_clockMultiplier = x->x_ch[10].val > 4000 ? 0 : 1;
	if(x->x_clockMultiplier != 0) {
		triggerSpeed = ((t_float)(2048 - x->x_ch[10].val) / 2048) /* * 10 */;
		if(triggerSpeed >= 0){
			speedId = (int)((triggerSpeed * x->clockMultLength)+0.5);
			x->x_clockMultiplier = x->clockMult[speedId];
		} else {
			speedId = (int)((triggerSpeed * x->clockDivLength)+0.5);
			t_float div = x->clockDiv[abs(speedId)];
			if (div > 0)
				x->x_clockMultiplier = 1 / div;
		}
	}	
	val++;
	t_float triggerState = 0;
	if(x->x_clockMultiplier > 0)
		triggerState = x->x_clockMultiplier;
	if(pTriggerState != triggerState){
		if(triggerState > 0){
			if(triggerState > 1)
				clock_unset(x->x_clockTriggeringGrains);
			clock_delay(x->x_clockTriggeringGrains, 0);
		}
	}
	pTriggerState = triggerState;

	// if(timeInMs <= dur / 2){
	// 	dur = (60000 / x->x_bpm) - ((timeInMs / 2) + 1);
	// } else {
	// 	dur = (60000 / x->x_bpm) + ((timeInMs / 2) + 1);
	// }
	// post("mult/div: %f", x->x_clockMultiplier);
	dur = (60000 / x->x_bpm);
	if (x->x_internalBpmClock > 0) {
		clock_delay(x->x_bpmClock, dur);
		clock_delay(x->x_strikeCvLed,0.f);
	}
	else
	{
		clock_unset(x->x_bpmClock);
	}
}


void tick_strikeTrigger(t_arbhar_gpio_tilde *x){
	writeToSharedMem(x, SHM_STR_CV, 1);
	//writeToSharedMem(x, SHM_STR_CV_VAL, 0);
}

void tick_strikeCvLed(t_arbhar_gpio_tilde *x){
	if(x->x_arbharMode != CALIBRATION_MODE)
	{
		static t_float val = 0;
		uint8_t col = AMBER_STRONG;
		if(x->x_internalBpmClock > 0 && x->x_clockMultiplier > 0){
			col = WHITE_STRONG;
		} 
		// else if(x->x_internalBpmClock > 0 && x->x_clockMultiplier == 0){
		// 	col = WHITE_AMBER_OFF;
		// }
		val = 1-val;
		//post("CV LED %f",val);
		//writeToSharedMem(x, SHM_STR_B, val > 0 ? 1 : 0);	
		if(val > 0){
			if(_getCurrentParamMode(x) == PERFORMANCE){
				_setStrikeLed(x,col);
				if(x->x_internalBpmClock > 0 && x->x_clockMultiplier == 0)
					clock_delay(x->x_strikeCvLed, 50);
				else
					clock_delay(x->x_strikeCvLed, 15);
			}
		}
		else {
			if(_getCurrentParamMode(x) == PERFORMANCE) {
				if(x->x_internalBpmClock > 0)
					_setStrikeLed(x,AMBER_DIM);
				else
					_setStrikeLed(x,WHITE_AMBER_OFF);
			}
		}
	}
}

void _setStrikeLed(t_arbhar_gpio_tilde *x, uint8_t col){
		static float pTime = 0;
		float cTime = x->x_dspFrameClock;
		if(cTime - pTime > 4) {
			t_atom ctlInfo[2];
			//post("strike LED %d", col);
			SETFLOAT(ctlInfo, col);
			SETFLOAT(ctlInfo+1,145);
			outlet_list(x->g_info_out, gensym("list"),2,ctlInfo);
		}
		pTime = cTime;
	
}


static void _decideLayerBufOp(t_arbhar_gpio_tilde *x, t_int lyr, t_int state) {
	t_int layer = lyr;
	//t_int layerState = state;
	switch(state) {
		case 1:
		{
			post("delete layer %d", layer);
			writeToSharedMem(x,layer+SHM_ALPHA_STATE,0);
			break;
		}
		case 2:
		{
			post("undo layer %d", layer);
			writeToSharedMem(x,layer+SHM_ALPHA_STATE,1);
			break;
		}
		default:
			break;
	}
	
	t_atom ctlInfo[3];
	//SETFLOAT(ctlInfo, 255);
	//SETFLOAT(ctlInfo+1, p);
	//SETFLOAT(ctlInfo+2, v);
	if(x->x_arbharMode < CALIBRATION_MODE)
		outlet_list(x->layerBufOp, gensym("list"),3,ctlInfo);
}

