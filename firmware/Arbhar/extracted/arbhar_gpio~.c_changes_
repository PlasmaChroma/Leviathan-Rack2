void _getButton(t_arbhar_gpio_tilde *x, t_button *b, uint8_t val) {
	uint8_t block = x->x_blockAllButtons;
	if(val != 255){
		b->value = val;
		b->prev = b->state;
		if(!b->ignore) { b->state = b->value; }
		b->changed = 1; 
		if(b->value > 0){
			if(!block)
				clock_delay(x->x_buttonDown, 0.f);
			b->falling = 0;
			b->raising = 1;
			b->timePressed = x->x_dspFrameClock;
		}
		else{
			if(!block)
				clock_delay(x->x_buttonUp, 0.f);
			b->prevTimePressed = b->timePressed;
			b->falling = 1;
			b->raising = 0;
		}
	} else {
		b->changed = 0 ;
	}
}

uint8_t _setOrder_button(t_buttons *temp, t_button *b){
	uint8_t order = 0;
	//if(b->changed ){
		if(b->state > 0){
			order = temp->shift.state;;
			order += temp->capture.state;
			order += temp->strike.state;
		} 
	//}
	b->order = order;
	return order;
}

uint8_t _setOrder_shift(t_buttons *temp){
	uint8_t order = temp->shift.order;
	if(temp->shift.changed ){
		if(temp->shift.state > 0){
			order = temp->shift.state;;
			order += temp->capture.state;
			order += temp->strike.state;
		} 
	}
	temp->shift.order = order;
	return order;
}

uint8_t _setOrder_capture(t_buttons *temp){
	uint8_t order = temp->capture.order;
	if(temp->capture.changed){
		if(temp->capture.state > 0){
			order = temp->capture.state;
			order += temp->shift.state;
			order += temp->strike.state;
		} 
	}
	temp->capture.order = order;
	return order;
}

uint8_t _setOrder_strike(t_buttons *temp){
	uint8_t order = temp->strike.order;
	if(temp->strike.changed){
		if(temp->strike.state > 0){
			order = temp->strike.state;
			order += temp->shift.state;
			order += temp->capture.state;
		}
	}
	temp->strike.order = order;
	return order;
}

