void _setModCvProcessesToMidValues(t_arbhar_gpio_tilde *x, t_float val)
{
	writeToSharedMem(x,SHM_MOD_PANNING, (int)val);
	writeToSharedMem(x,SHM_MOD_HOLD, (int)val);
	writeToSharedMem(x,SHM_MOD_REVERB, (int)val);
	writeToSharedMem(x,SHM_MOD_DELAY, (int)val);
}

void _setAdcSampRate(t_arbhar_gpio_tilde *x, t_float val){
	x->adc_samp_rate = val;
	if(val < 0.125)
		x->adc_samp_rate = x->main_adc_samp_rate;
	post("x->adc_samp_rate: %f",x->adc_samp_rate);
	if(val < 1)
		x->strike_samp_rate = STRIKE_SAMP_RATE;
	post("x->strike_samp_rate: %f",x->strike_samp_rate);
}

void _setStrikeSampRate(t_arbhar_gpio_tilde *x, t_float val){
	x->strike_samp_rate = val;
	post("x->strike_samp_rate: %f",x->strike_samp_rate);
}

void _setModCVMode(t_arbhar_gpio_tilde *x, t_float cvMode)
{
	_setModCvProcessesToMidValues(x, 2048);
	int mode = (int)cvMode;
	post("mode: %d - %f", mode, cvMode);
	switch (mode) {
		case 1: {
			x->x_modToPanning = 1;
			x->x_modToHold = 0;
			x->x_modToReverb = 0;
			x->x_modToDelay = 0;
			break;
		}
		case 2: {
			x->x_modToPanning = 0;
			x->x_modToHold = 1;
			x->x_modToReverb = 0;
			x->x_modToDelay = 0;
			break;
		}
		case 3: {
			x->x_modToPanning = 0;
			x->x_modToHold = 0;
			x->x_modToReverb = 1;
			x->x_modToDelay = 0;
			break;
		}
		case 4: {
			x->x_modToPanning = 0;
			x->x_modToHold = 0;
			x->x_modToReverb = 0;
			x->x_modToDelay = 1;
			break;
		}
		default: {
			x->x_modToPanning = 0;
			x->x_modToHold = 0;
			x->x_modToReverb = 0;
			x->x_modToDelay = 0;
			break;
		}
	}
	post("modCV: %d, %d, %d, %d", x->x_modToPanning, x->x_modToHold, x->x_modToReverb, x->x_modToDelay);
}

t_float scaleAdcToReducedRange(t_float input, t_float mid_val, t_float notch_width, t_float low_thresh, t_float high_thresh)
{
	const t_float max_out = 4095;
	const t_float mid_out = 2048;

	if(input < low_thresh)
		return 0;
	else if (input > high_thresh)
		return max_out;
	else if (input >= mid_val - notch_width && input <= mid_val + notch_width)
		return mid_out;
	else if (input < mid_val - notch_width)
		return (input - low_thresh) * (mid_out) / (mid_val - low_thresh);
	else
		return (input - mid_val) * (max_out - mid_out) / (high_thresh - mid_val) + mid_out;
}


t_float scaleLedToMid(float val) {
	t_float retVal;
	if (val < 36) {
		retVal = (val / 36) * 46;
	}
	else {
		retVal = (((val - 36) / 36) * 26) + 46;
	}
	return retVal;
}

static void _changeParamMode(t_arbhar_gpio_tilde *x, t_float mode){
	static t_float prevMode = 0;
	t_float cMode = mode;
	if(prevMode != cMode){
		x->x_paramModeInfo.time_entered = x->x_dspFrameClock;
		x->x_paramModeInfo.prev_param_mode = x->x_paramModeInfo.current_param_mode;
		x->x_paramModeInfo.prev_had_param_changes = x->x_paramModeInfo.current_has_param_changes > 0 ? 1 : 0;
		x->x_paramModeInfo.prev_time_entered = x->x_paramModeInfo.time_entered;
		x->x_paramModeInfo.current_param_mode = (uint8_t)cMode;
		x->x_paramModeInfo.time_entered = x->x_dspFrameClock;

	/*	post("changed parameter mode from %s to %s at %d", 
					getModeName(x->x_paramModeInfo.prev_param_mode), 
					getModeName(x->x_paramModeInfo.current_param_mode), 
					x->x_paramModeInfo.time_entered);*/
		prevMode = cMode;
		
	}
}

void _setCurrentParamMode(t_arbhar_gpio_tilde *x, t_float mode)
