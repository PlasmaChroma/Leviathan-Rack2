/**
enum mcpCh: {
0	VPO = 2, //V/Oct
1	LYC = 4, //Layer CV
2	SCC = 7, //Scan CV
3	TEX = 14, //texture
4	DIR = 10, //Direction
6	MOD = 13, // Mod
5	LEN = 1, //Length
7	SCP = 0, // Scan Pot
8	DW = 6, // Dry/Wet
9	PI = 3, //Pitch
10	INT = 12, //Intensity
11	LYP = 5, //Layer Pot
12	SPR = 9, //Spray
13	HOL = 8, //Hold
14	DUB = 11, //Overdub
15	DEV = 15 //Deviation
	
};*/

typedef struct _mcp_ch_struct {
	uint8_t ch;
	t_float raw;
	uint8_t ignore;
	uint16_t val;
	t_float	last;
	t_float buf[100];
	uint16_t lowest;
	uint16_t highest;
	t_float mid;
	t_float avg;
	t_float notch;
	uint16_t bufCount;
	uint16_t bufCountMax;
	uint8_t freeze;
	uint16_t freezeCount;
	uint16_t freezeThresh;
	uint16_t freezeCountMax;
	t_float	lastFrozen;
	t_symbol *name;

} t_mcp_ch;

typedef struct _gpioButton {
	uint8_t value;
