}

static void printMcpChValues(t_arbhar_gpio_tilde *x, t_float f){
	t_float ch = f;
	if(ch < 0 || ch > 15) ch = -1;
	x->printMcpChValue = ch;
	post("printMcpChValue %f", ch);
}

uint16_t readADC(int _device, int _channel){
	char spi_data[3];
	uint8_t input_mode = 1; // single ended = 1, differential = 0
	uint16_t result;
	uint8_t dev = (uint8_t)_device;
	
	//bcm2835_spi_begin();
	//bcm2835_spi_setClockDivider(BCM2835_SPI_CLOCK_DIVIDER_64);

	if(_channel > 7 | _channel < 0){
		return -1;
	}

	spi_data[0] = 0x04; // start flag
	spi_data[0] |= (input_mode<<1); // shift input_mode
	spi_data[0] |= (_channel>>2) & 0x01; // add msb of channel in our first command byte

	spi_data[1] = _channel<<6;
	spi_data[2] = 0x00;
	bcm2835_spi_chipSelect(dev);
	bcm2835_spi_transfern(spi_data, 3);
	//bcm2835_spi_end();
	//bcm2835_st_delay(0, 100);

	result = ((spi_data[1] & 0x0f)<<8) | spi_data[2];
	return result;
}

static t_float _getPlayLayer(t_arbhar_gpio_tilde *x)
{
	t_float pLayer = x->x_playLayer;
	if(x->x_omega)
		pLayer = x->x_omegaPlayLayer;
	return (pLayer + 1);
}

void setMid(t_mcp_ch* ch, t_float val) 
{ 
	ch->mid = val; 
	ch->freeze = 0;
	ch->lastFrozen = 0;
	ch->last = 0; 
}
	
void setNotch(t_mcp_ch* ch, t_float val) 
{ 
	ch->notch = val; 
};

void setBufCountMax(t_mcp_ch* ch, t_float val) 
{ 
	ch->bufCountMax = val; 
};

void setFreezeCountMax(t_mcp_ch* ch, t_float val) 
{ 
	ch->freezeCountMax = val; 
};

void setFreezeThresh(t_mcp_ch* ch, uint16_t val) 
{ 
	ch->freezeThresh = val; 
	//post("frrzeThresh %d: %d", ch->ch, ch->freezeThresh);
};

void _setFreezeThresh(t_arbhar_gpio_tilde* x, t_float ch, t_float v) 
{
	uint8_t channel = (uint8_t)ch;
	uint16_t value = (uint16_t)v;
	setFreezeThresh(&x->x_ch[channel], value);
}


void _setFreezeCount(t_arbhar_gpio_tilde* x, t_float ch, t_float v) 
{
	uint8_t channel = (uint8_t)ch;
	uint16_t value = (uint16_t)v;
	setFreezeCountMax(&x->x_ch[channel], value);
}

void _learnMid(t_arbhar_gpio_tilde* x) 
{ 
	post("raw mcp values copied to set mid:");
	for(int i=0;i<16;i++) 
	{
		x->x_ch[i].mid = x->x_ch[i].avg;
		post("mcpCh %d: %d -- %d", i, (int)x->x_ch[i].mid, MCP_CH_SEQUENTIALLY[i]);
	}
	
};

void _setMidValue(t_arbhar_gpio_tilde* x, t_symbol *s, t_int argc, t_atom *argv)
{
	//t_symbol *unused, int argc, t_atom *argv
	post("received %d elements", argc);
	t_int offset = (t_int)atom_getfloat(argv);
	post("start setting at %d", offset);
	for(int i=1;i<argc;i++){
		t_float mid = atom_getfloat(argv+i);
		t_int ch = 0;
		t_int ordNo = 0;
		for(int j=0;j<16;j++) 
		{
			if(i+offset-1 == x->x_ch[j].ch) {
				ch = x->x_ch[j].ch;
				ordNo = j;
			}
		}
		post("received %f, channel: %d as element %d.", mid, ch, ordNo);
		setMid(&x->x_ch[ordNo],mid);
	}
}



void _setMidValueByCh(t_arbhar_gpio_tilde* x, t_symbol *s, t_int argc, t_atom *argv)
{
	//t_symbol *unused, int argc, t_atom *argv
	//post("received %d elements", argc);
	if(argc > 1){
		static int count = 0;
		t_int midVal = (t_int)atom_getfloat(argv+1);
		if(midVal < 0)
			count = 0;
		else{
			if(count < 16){
				post("received mid value: count %d: order: %d midVal: %d", count, MCP_CH_SEQUENTIALLY[count], midVal);
				x->x_ch[MCP_CH_SEQUENTIALLY[count]].mid = (t_float)midVal;
				//if(count == 13)
					//_setModCvProcessesToMidValues(x,2048);
				post("set mid value: count %d: order: %d midVal: %d", count, MCP_CH_SEQUENTIALLY[count], (int)x->x_ch[MCP_CH_SEQUENTIALLY[count]].mid);
				count++;
			}
			else
				_setVpo3VoltValue(x,midVal);
		}
	}

}

static void _takeCalibrationValues(t_arbhar_gpio_tilde *x, t_float notUsed){
	
	//mid value saving routine
	static int count = 0;
	
	if(count == 0) {
	_learnMid(x);
	post("---------------------");
	for (int p=0;p<16;p++)
	{ 
		int i = MCP_CH_SEQUENTIALLY[p];
		t_int mcpCh = x->x_ch[i].ch;
		t_int eepromId = mcpCh + 192;
		x->x_ch[i].mid = x->x_ch[i].last;
		t_int midVal = (t_int)x->x_ch[i].last;
		t_int msb = makeSixBitMsb(midVal);
		t_int lsb = makeSixBitLsb(midVal);
		t_int check = combineSixBitMsbLsb(msb, lsb);
		post("order %d: ch %d mid value: %d to be saved at %d as %d %d | check: %d",i, mcpCh, midVal, eepromId, msb, lsb, check);
		t_atom eepromData[3];
		SETFLOAT(eepromData, eepromId);
		SETFLOAT(eepromData+1, lsb);
		SETFLOAT(eepromData+2, msb);
		outlet_list(x->eeprom_out, gensym("list"),3,eepromData);
	}
	t_int threeOctaveValue = x->x_vpo3VoltValue;
	t_atom vpo3volt[3];
	t_int msb = makeSixBitMsb(threeOctaveValue);
	t_int lsb = makeSixBitLsb(threeOctaveValue);
	SETFLOAT(vpo3volt, 16 + 192);
	SETFLOAT(vpo3volt+1, lsb);
	SETFLOAT(vpo3volt+2, msb);
	outlet_list(x->eeprom_out, gensym("list"),3,vpo3volt);
	post("vpo3Volt: %d to be saved at %d as %d %d | check: %d",threeOctaveValue, 16 + 192, msb, lsb, combineSixBitMsbLsb(msb, lsb));
	
	t_atom calibrationEnd[2];
	SETFLOAT(calibrationEnd, 255);
	SETFLOAT(calibrationEnd+1, 255);
	outlet_list(x->eeprom_out, gensym("list"),2,calibrationEnd);
	
	//exit calibration mode
	//TODO: enter testing mode
	t_atom ctlInfo[1];
	SETFLOAT(ctlInfo, 254);
	outlet_list(x->eeprom_out, gensym("list"),1,ctlInfo);
	x->x_arbharMode = TESTING_MODE; 
	
	t_atom calibrationInfo[1];
	SETSYMBOL(calibrationInfo, gensym("finishedCalibration"));
	//SETFLOAT(calibrationInfo+1, p);
	//SETFLOAT(calibrationInfo+2, v);
	if(x->x_arbharMode >= CALIBRATION_MODE)
		outlet_list(x->layerBufOp, gensym("list"),1,calibrationInfo);
	}
	count++;
}


