void _shmem_writeValue(t_arbhar_gpio_tilde *x, t_symbol *unused, int argc, t_atom *argv)
{
    if ( !x->share_memory ){
        error("Create a valid shared memory before setting data !");
        return;
    }

    int i, j, index_max, shmem_offset, array_offset, size;

	if (argc < 1) {
		pd_error(x, "shmem usage : [memset table_name [table_name []]< or [memset src_offset data [dest_offset]< (data can be a float, a list, or a table name)");
		return;
	}

  for ( int i=0; i<argc; ++i){
    int j = 0;
    if ( argv[i].a_type == A_SYMBOL ){
      _shmem_writeValues(x, atom_getsymbolarg(i,argc,argv), 0, j, x->segment_size);
    } else {
      break;
    }
  }

 if ((argc > 1) && (argv[0].a_type == A_FLOAT) ) {
		shmem_offset = atom_getfloatarg(0,argc,argv);
		if (shmem_offset < 0) shmem_offset=0;

		if (argv[1].a_type == A_SYMBOL) { // argument is an arrayname
			array_offset = 0;
			size = x->segment_size;
			if ((argc > 2) && (argv[2].a_type == A_FLOAT))
				array_offset = atom_getfloatarg(2,argc,argv);
			if (array_offset < 0) array_offset=0;
			if ((argc > 3) && (argv[2].a_type == A_FLOAT))
				size = atom_getfloatarg(3,argc,argv);
			_shmem_writeValues(x, atom_getsymbolarg(1,argc,argv), array_offset, shmem_offset, size);
		}
		else if (argv[1].a_type == A_FLOAT) { // argument is a float
			index_max = x->segment_size - shmem_offset;
			if (index_max > argc-1) index_max = argc-1;
			for (i=0; i<index_max ; i++)
				x->share_memory[i+shmem_offset]=atom_getfloatarg(i+1, argc, argv);
		}
	}
}

void writeToSharedMem(t_arbhar_gpio_tilde *x, uint8_t n, u_int32_t val)
{
    if ( !x->share_memory ){
        error("Create a valid shared memory before setting data !");
        return;
    }

    int index_max, shmem_offset, array_offset, size;

	shmem_offset = n;
	if (shmem_offset < 0) shmem_offset=0;

	index_max = x->segment_size - shmem_offset;
	x->share_memory[shmem_offset]=(t_float)val;
}



void writeFloatToSharedMem(t_arbhar_gpio_tilde *x, uint8_t n, t_float val)
{
    if ( !x->share_memory ){
        error("Create a valid shared memory before setting data !");
        return;
    }
    
    float v = (float)val;

    int index_max, shmem_offset, array_offset, size;

	shmem_offset = n;
	if (shmem_offset < 0) shmem_offset=0;

	index_max = x->segment_size - shmem_offset;
	x->share_memory[shmem_offset]=v;
}

void writeChunkToSharedMem(t_arbhar_gpio_tilde *x, uint8_t offset, uint32_t *val, uint16_t n)
{
    if ( !x->share_memory ){
        error("Create a valid shared memory before setting data !");
        return;
    }
    uint16_t *values = val;

    int /*i, j, */index_max, shmem_offset, array_offset, size;

	shmem_offset = offset;
	if (shmem_offset < 0) shmem_offset=0;

	index_max = x->segment_size - shmem_offset;
	for(int i=0; i<n; i++){
		uint8_t ch = x->x_ch[shmem_offset+i].ch;
		x->share_memory[ch]=(t_float)values[i];
		//post("value %d: %d", ch, values[i]);
	}
}

void _getCaptureCvToShMem(t_arbhar_gpio_tilde *x){
	writeToSharedMem(x, SHM_CPT_CV_VAL, !bcm2835_gpio_lev(CAPTURE_CV));
}

int _adaptInternalBpm(t_arbhar_gpio_tilde *x){
	int notAdapted = 1;
	float filterVal = BPM_FILTER_VAL;
	if(x->x_bpm_suggestedFromCV > 0){
		filterVal = 0.1;
		x->x_bpm_suggestedFromManual = -1; //cancel potential manual tempo change
		if(fabs(x->x_bpm - x->x_bpm_suggestedFromCV) > (x->x_bpm * 0.1)){
			x->x_bpm = (x->x_bpm * filterVal) + (x->x_bpm_suggestedFromCV * (1 - filterVal));
		} else {
			x->x_bpm = x->x_bpm_suggestedFromCV;
		}
		notAdapted = 0;
	} else if(x->x_bpm_suggestedFromManual > 0){
		if(fabs(x->x_bpm - x->x_bpm_suggestedFromManual) > (x->x_bpm * 0.1)){
			x->x_bpm = (x->x_bpm * filterVal) + (x->x_bpm_suggestedFromManual * (1 - filterVal));
		} else {
			x->x_bpm = x->x_bpm_suggestedFromManual;
		}
		t_atom configurationInfo[2];
		SETSYMBOL(configurationInfo, gensym("ClockBPM"));
		SETFLOAT(configurationInfo+1, x->x_bpm_suggestedFromManual);
		if(x->x_arbharMode < CALIBRATION_MODE)
			outlet_list(x->config_out, gensym("list"),2,configurationInfo);
		notAdapted = 0;
	}
	if(x->x_bpm == x->x_bpm_suggestedFromCV){
		x->x_bpm_suggestedFromCV = -1;
	}
	if(x->x_bpm == x->x_bpm_suggestedFromManual){
		x->x_bpm_suggestedFromManual = -1;
	}

	return notAdapted;
}

void _getTimeFromStrikeCV(t_arbhar_gpio_tilde *x) {
	static int pFrame = 0;
	int frame = x->x_dspFrameClock;
	x->lastExternalClockFrame = frame;
	x->x_timeBetweenStrikeCV = ((float)(frame - pFrame) * 64.f) / 48.f;
	if(x->x_timeBetweenStrikeCV < 2500 && x->x_timeBetweenStrikeCV >= 1) {
		x->x_bpmStrikeCV = 60000 / (x->x_timeBetweenStrikeCV * x->x_inputClockDivision);

		//x->x_bpm = x->x_bpmStrikeCV;
		x->x_bpm_suggestedFromCV = x->x_bpmStrikeCV;
	}
	//post("duration: %f \ bpm: %f",x->x_timeBetweenStrikeCV, x->x_bpmStrikeCV);
	pFrame = frame;
}

void _getTimeFromStrikeButton(t_arbhar_gpio_tilde *x) {
	static int pFrame = 0;
	int frame = x->x_dspFrameClock;
	x->x_timeBetweenStrikeButton = ((float)(frame - pFrame) * 64.f) / 48.f;
	if(x->x_timeBetweenStrikeButton < 2500) {
		x->x_bpmStrikeButton = 60000 / x->x_timeBetweenStrikeButton;
		//x->x_bpm = x->x_bpmStrikeButton;
		x->x_bpm_suggestedFromManual = x->x_bpmStrikeButton;
	}
	post("button duration: %f \ bpm: %f",x->x_timeBetweenStrikeButton, x->x_bpmStrikeButton);
	pFrame = frame;
}

void _getStrikeCvToShMem(t_arbhar_gpio_tilde *x){
	static uint8_t pCvVal = 0;
	static int strikeCount = 0;
	uint8_t cvVal = !bcm2835_gpio_lev(STRIKE_CV);
	if(pCvVal != cvVal){ 
		//post("strike: %d",cvVal);
		if (cvVal > 0) {
			if(x->x_internalBpmClock == 0) {
				writeToSharedMem(x, SHM_STR_CV_VAL, strikeCount++);
				if(strikeCount > 10000) strikeCount = 0;
				clock_delay(x->x_strikeTrigger, x->x_strikeCvDelay);
				_setStrikeLed(x,AMBER_STRONG);
				clock_delay(x->x_strikeCvLed, 10);
			//	post("strike: %d",strikeCount);
			} else {
				if( x->x_internalBpmClock > 0) {
					//clock_unset(x->x_clockTriggeringGrains);
					_getTimeFromStrikeCV(x);
					//(x->x_clockTriggeringGrains,0);
				}
			}
			//_setStrikeLed(x,AMBER_STRONG);
			//clock_delay(x->x_strikeCvLed, 10);
		}
	}
	pCvVal = cvVal;
	clock_delay(x->x_getStrike, x->strike_samp_rate);
}


void _setDspSynced(t_arbhar_gpio_tilde *x, t_float val)
{
	x->x_dspSynced = (uint8_t)val;
	post("dspSynced: %d", x->x_dspSynced);
	
	if(val) {
		//if(!bcm2835_spi_begin())
			//post("Error starting SPI!");
		clock_set(x->x_getFromGpio, 0.f);
		clock_set(x->x_getStrike, 0.f);
	}
}

void _setCalibrationMode(t_arbhar_gpio_tilde *x) {
	static count = 0;
	t_int calibrate = _checkForCalibrationFileOnBoot(x);
	if(count > 0)
		outlet_float(x->calibrated_out, calibrate);
	if( calibrate == 1)
		x->x_arbharMode = CALIBRATION_MODE;
	post("Arbhar Mode: %d", x->x_arbharMode);
	count++;
}

