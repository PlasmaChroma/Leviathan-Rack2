{
	return b->state;
}

uint8_t _getButtonRelease(t_button *b)
{
	return b->falling;
}

uint8_t _getButtonOrder(t_button *b)
{
	return b->order;
}

uint8_t _getButtonIgnore(t_button *b)
{
	return b->ignore;
}

void _setButtonIgnore(t_button *b, uint8_t val)
{
	 b->ignore = val;
}

void _shareRecordingStateToShMem(t_arbhar_gpio_tilde *x)
{
	writeToSharedMem(x,SHM_REC_POS,x->x_recordingPos);
	//post("sharing x_recording = %d, record head set to %d", x->x_recording, x->x_recordingPos);
	writeToSharedMem(x, SHM_RECORD, x->x_recording);
	if(x->x_recording > 0) {
		int layer = x->x_recLayer + SHM_ALPHA_STATE;
		int current = readFromSharedMem(x,layer);
	//	post("RecordingState %d = %d",layer, current);
		if(current < 2)
			current += 1;
		writeToSharedMem(x,layer,current);
	//	post("writing %d into layer slot %d",current,layer);
	}
	
}

void _toggleRecordingState(t_arbhar_gpio_tilde *x) {
	x->x_recording = 1 - x->x_recording;
	if(!x->x_accumRecording){
		x->x_recordingPos = 0;
		if(x->x_recording > 0)
			x->x_followPosition = 0;
	}
	else {
		if(x->x_recordingPos > MAX_BUFFER_DISPLAY)
			x->x_recordingPos = 0;
	}
	_shareRecordingStateToShMem(x);
}

void _setRecordingStateWithReset(t_arbhar_gpio_tilde *x, uint8_t val) {
	x->x_recording = val;
	if(val > 0){
		x->x_recordingPos = 0;
		//writeToSharedMem(x,SHM_REC_POS,0);
	}
	//post("GATE CAPTURE with reset = %d pos %d", x->x_recording, x->x_recordingPos);
	_shareRecordingStateToShMem(x);
}

void _setRecordingState(t_arbhar_gpio_tilde *x, uint8_t val) {
	x->x_recording = val;
	if(val > 0 && x->x_recordingPos > MAX_BUFFER_DISPLAY)
		x->x_recordingPos = 0;
	//post("CAPTURE = %d from sample %f", x->x_recording, x->x_recordingPos);
	_shareRecordingStateToShMem(x);
}

void _copyScanPositionToRecordingPos(t_arbhar_gpio_tilde *x) {
	
	post("COPY SCAN POS %f to replace REC POS %f", x->x_scanPosition, x->x_recordingPos);
	x->x_recordingPos = x->x_scanPosition;
	writeToSharedMem(x,SHM_REC_POS,x->x_scanPosition);
}

void _toggleAccumRecording(t_arbhar_gpio_tilde *x, t_int force) {

	static uint8_t pLink = 255;
	static uint8_t pCaptGate = 255;
	static uint8_t pButtonUp = 255;
	if(pLink == 255)
		pLink = x->x_linkAccumCaptureAsGate;
	if(pCaptGate == 255)
		pCaptGate = x->x_captureButtonMode;
	if(pButtonUp == 255)
		pButtonUp = x->x_recOnButtonUp;
	
	if(force < 0)
		x->x_accumRecording = 1 - x->x_accumRecording;
	else
		x->x_accumRecording = force;
	writeToSharedMem(x, SHM_ACCUM_REC, x->x_accumRecording);
	post("ACCUM RECORDING = %d", x->x_accumRecording);
	_shareRecordingStateToShMem(x);
	if(x->x_linkAccumCaptureAsGate > 0 && x->x_accumRecording > 0) {
		x->x_captureButtonMode = 1;
		x->x_recOnButtonUp = 0;
	} else if (x->x_accumRecording == 0){
		x->x_captureButtonMode = pCaptGate;
		x->x_recOnButtonUp = pButtonUp;
	}
	t_atom configurationInfo[2];
	//SETSYMBOL(configurationInfo, gensym("AccumulateRecordingsInLayer"));
	SETSYMBOL(configurationInfo, gensym("AccumulativeCaptureMode"));
	SETFLOAT(configurationInfo+1, x->x_accumRecording);
	//SETFLOAT(configurationInfo+2, v);
	if(x->x_arbharMode < CALIBRATION_MODE)
		outlet_list(x->config_out, gensym("list"),2,configurationInfo);
}

void _strikeToPlayGrain(t_arbhar_gpio_tilde *x) {
	x->x_strikeColour = AMBER_STRONG;
	//clock_delay(x->x_strikeLed,0.0f);
	//post("strike to play grain");
	if(x->x_followMode) {
		x->x_followPosition = 0;
		//x->x_followPosition = x->x_followPosOffset;
	}
}

void _strikeCvToPlayGrain(t_arbhar_gpio_tilde *x) {
	clock_delay(x->x_strikeCvLed,x->x_strikeCvDelay);

}

void checkFileProcessProgress(t_arbhar_gpio_tilde *x) {
	
	static int prevActivityVal = 0;
	int activityVal = readFromSharedMem(x, SHM_FILE_PROCESSING) > 0 ? 1 : 0;
	
	if(prevActivityVal != activityVal)
	{
		t_buttons *temp = &x->x_buttons;
		if(temp->mode >= PARAM_TOGGLED && activityVal == 0)
		{
			//post("activity: %d -- %d", activityVal, temp->mode);
			temp->mode = PERFORMANCE;
			_changeParamMode(x,temp->mode);
			x->x_checkFileProcess = 0;
			tick_processButtonDown(x);
			tick_processButtonUp(x);
		}
		prevActivityVal = activityVal;
	}
}

void tick_processButtonDown(t_arbhar_gpio_tilde *x) {
	static int initialisationCount = 0;
	if(x->x_arbharMode < CALIBRATION_MODE)
	{
		//post("_______\\/________\n|processing button down event");
		t_buttons *temp = &x->x_buttons;
		_setOrder_shift(temp);
		_setOrder_capture(temp);
		_setOrder_strike(temp);
		if(temp->mode == PARAM_TOGGLED  && _getButtonOrder(&temp->shift) == 0 && _getButtonOrder(&temp->capture) == 0 && _getButtonOrder(&temp->strike) == 3){
			//post("*********\nCOUNT FOR INITIALISATION\n*********");
			//post(">> %d <<>> %d <<>> %d",_getButtonOrder(&temp->shift), _getButtonOrder(&temp->capture), _getButtonOrder(&temp->strike));
			int timer = temp->strike.timePressed - temp->strike.prevTimePressed;
			if(timer > 200)
				initialisationCount = 0;
			else
				initialisationCount++;
			post("initialisationCount = %d", initialisationCount);
			if(initialisationCount > 6){
				t_atom initAllInfo[1];
				SETSYMBOL(initAllInfo, gensym("INIT_ALL"));
				//SETFLOAT(initAllInfo + 1, section);
				outlet_list(x->config_out, gensym("list"), 1, initAllInfo);
				temp->mode = PERFORMANCE;
				_changeParamMode(x,temp->mode);
				t_atom ctlInfo[4];
				SETFLOAT(ctlInfo, 85);
				SETFLOAT(ctlInfo+1, 147);
				SETFLOAT(ctlInfo+2, 42);
				SETFLOAT(ctlInfo+3, 146);
				outlet_list(x->toSerial, gensym("list"),4,ctlInfo);
			}
		}
		if(temp->mode >= PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 && _getButtonOrder(&temp->capture) == 2 && _getButtonOrder(&temp->strike) == 3) {
			temp->mode = PERFORMANCE;
			//led_controlForRecording(x);
			_changeParamMode(x,temp->mode);
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 && _getButtonOrder(&temp->capture) == 2 && _getButtonOrder(&temp->strike) == 3) {
			temp->mode = PARAM_TOGGLED;
			_setRecordingState(x,0);
			//post("*********\nCOUNT FOR INITIALISATION?\n*********");
			temp->shift.order = 0;
			temp->capture.order = 0; 
			temp->strike.order = 0;
			_changeParamMode(x,temp->mode);
			_setWhiteLyrLedPulse(x,0);
			writeToSharedMem(x,SHM_PARAM_TOGGLED,1);
			x->x_protectPlayLayerValue = 1;
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 
											&& _getButtonOrder(&temp->capture) == 2 
											&& _getButtonOrder(&temp->strike) != 3 
											&& _getCurrentParamMode(x) != TRACK_AND_HOLD) {
			temp->mode = PARAM_MOMENTARY;
			_changeParamMode(x,temp->mode);
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 
											&& _getButtonOrder(&temp->capture) == 2 
											&& _getButtonOrder(&temp->strike) != 3 
											&& _getCurrentParamMode(x) == TRACK_AND_HOLD) {
			post("*********\nRESET RECORDING SETTINGS\n*********");
			x->x_recordingPos = 0;
			_toggleAccumRecording(x, 0);
			_setRecordingStateWithReset(x,0);
			_toggleAccumRecording(x, 1);
			post("rec position %d", (int)x->x_recordingPos);
			
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 
											&& _getButtonOrder(&temp->capture) != 2 
											&& _getButtonOrder(&temp->strike) == 2
											&& _getCurrentParamMode(x) != TRACK_AND_HOLD) {
			//temp->mode = PERFORMANCE;
			//_changeParamMode(x,temp->mode);
			post("*********\nBUFFER OPERATION\n*********");
			int layer = x->x_recLayer;
			int state = (int)readFromSharedMem(x,layer + 124);
			post("Layer %d has state %d", x->x_recLayer, state);
			_decideLayerBufOp(x,layer,state);
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 
											&& _getButtonOrder(&temp->capture) != 2 
											&& _getButtonOrder(&temp->strike) == 2
											&& _getCurrentParamMode(x) == TRACK_AND_HOLD) {
			post("*********\nCOPY SCAN POSITION AS RECORDING POSITION\n*********");
			_copyScanPositionToRecordingPos(x);
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 
											&& _getButtonOrder(&temp->capture) != 2 
											&& _getButtonOrder(&temp->strike) != 3) {
			temp->mode = PARAM_SHIFT;
			int timeDelta = temp->shift.timePressed - temp->shift.prevTimePressed;
			//post("time between shift presses: %d",timeDelta);
			if(timeDelta < 200 && _getCurrentParamMode(x) == PERFORMANCE){
	//			post("TRACK_AND_HOLD: time between shift presses: %d",timeDelta);
				temp->mode = TRACK_AND_HOLD;
				led_backgroundControl(x,55,0);
			}
			_changeParamMode(x,temp->mode);
			//post("param mode: %d", _getCurrentParamMode(x));
		}
		else if(temp->mode < PARAM_TOGGLED && _getButtonOrder(&temp->shift) < 1 && _getButtonOrder(&temp->capture) <= 2 && _getButtonOrder(&temp->strike) <= 3) {
			temp->mode = PERFORMANCE;
			_changeParamMode(x,temp->mode);
			if(_getButtonState(&temp->capture) && x->x_recOnButtonUp && !x->x_captureButtonMode) {
				//post("*********\nAWAIT CAPTURE ACTION\n*********");
				x->x_awaitRecording = 1;
			}
			else if(_getButtonState(&temp->capture) && !x->x_recOnButtonUp && !x->x_captureButtonMode) {
				if( x->x_dspFrameClock - temp->capture.timePressed < 2){
					//post("*********\nCAPTURE\n*********");
					//post("capture %d - %d", temp->capture.timePressed, x->x_dspFrameClock);
					_toggleRecordingState(x);
				}
			}
			else if(_getButtonState(&temp->capture) && x->x_captureButtonMode) {
				if( x->x_dspFrameClock - temp->capture.timePressed < 2){
					if(x->x_accumRecording)
						_setRecordingState(x,1);
					else
						_setRecordingStateWithReset(x,1);
				}
			}
			if(_getButtonState(&temp->strike)) {
				if( x->x_dspFrameClock - temp->strike.timePressed < 2){
					//post("*********\nSTRIKE\n*********");
					if( x->x_internalBpmClock > 0 && temp->mode == PERFORMANCE)
						_getTimeFromStrikeButton(x);
					else
					{
						_strikeToPlayGrain(x);
						clock_delay(x->x_strikeLed,0.0f);
					}
					
					if(x->x_strikeToTrigger > 0){
						_setTriggerOut(1);
						clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
						post("*********\nTRIGGER_GATE_OUT_FROM_STRIKE\n*********");
					} else if (x->x_currentOnsetMode->strikeCtrl > 0) {
						_setTriggerOut(1);
						clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
						//post("*********\nTRIGGER_GATE_OUT_FROM_STRIKE\n*********");
					}
				}
			}
		}
		else if(temp->mode == PERFORMANCE && _getButtonOrder(&temp->shift) == 2 && _getButtonOrder(&temp->capture) == 1 && _getButtonOrder(&temp->strike) == 0) {
			//post("*********\ncapture followed by shift for amending recordings\n*********");
			_toggleAccumRecording(x, -1);
		}
		/*else if(temp->mode >= PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 && _getButtonOrder(&temp->capture) == 0 && _getButtonOrder(&temp->strike) == 0) {
			post("*********\nLOAD_SOMETHING\n*********");
		}*/
		else if(temp->mode >= PARAM_TOGGLED && _getButtonOrder(&temp->shift) == 1 && _getButtonOrder(&temp->capture) == 2 && _getButtonOrder(&temp->strike) == 3) {
			temp->mode = PERFORMANCE;
			_changeParamMode(x,temp->mode);
		} else if (temp->mode >= PARAM_TOGGLED && _getButtonOrder(&temp->shift) < 2 && _getButtonOrder(&temp->capture) < 2 && _getButtonOrder(&temp->strike) < 2) {
			//post("*********\nfile manager stuff\n*********");
			if(_getButtonState(&temp->capture)){
				//post("*********\ndec page\n*********");
				x->x_paramPage--;
				if (x->x_paramPage == 255) x->x_paramPage = 2;  //x->x_paramPage is a uint8_t !!
	//			_sendMenuComand(x,112,x->x_paramPage);
			}
			if(_getButtonState(&temp->strike)) {
				//post("*********\ninc page\n*********");
				x->x_paramPage++;
				if (x->x_paramPage > 2) x->x_paramPage = 0;  //x->x_paramPage is a uint8_t !!
	//			_sendMenuComand(x,112,x->x_paramPage);
			}
			if(_getButtonState(&temp->shift)) {
				uint32_t timeSinceLast = temp->shift.timePressed - temp->shift.prevTimePressed;
				//post("*********\nPREVIEW_SOMETHING\n*********");
				if(x->x_copyFileNumber < 255 && timeSinceLast < 200 && x->x_paramPage == 0){
					x->x_previewEnable = 0;
					int loadInfo = x->x_playLayer * 100;
					int fileBank = (x->x_copyFileNumber / 6) + 1;
					int fileSlot = (x->x_copyFileNumber % 6) + 1;
					loadInfo += fileBank * 10;
					loadInfo += fileSlot;
					post("LOADING into layer %d file no %d: shmem 122: %d", x->x_playLayer, x->x_copyFileNumber, loadInfo);
					writeToSharedMem(x,SHM_LAOD_FILE,loadInfo);
					x->x_checkFileProcess = 1;
				} else if(x->x_copyFileNumber < 255 && timeSinceLast >= 200 && x->x_paramPage == 0){
					post("*********\nPREVIEW_ENABLE\n*********");
					x->x_previewEnable = 1;
				}
				if(x->x_copyLayerTo < 255 && timeSinceLast < 200 && x->x_paramPage == 0){
					int copyInfo = (x->x_playLayer+1) * 100;
					copyInfo += x->x_copyLayerTo;
					writeToSharedMem(x,SHM_BUFFER_COPY,copyInfo);
					post("page %d: COPYING from layer %d to %d: shmem 120: %d", x->x_paramPage, x->x_playLayer, x->x_copyLayerTo, copyInfo);
					writeToSharedMem(x,SHM_SHMEM_COPY,1);
				} else {
					writeToSharedMem(x,SHM_BUFFER_COPY,0);
					writeToSharedMem(x,SHM_SHMEM_COPY,0);
				}
				//LOADING ARBHAR SCENE FROM USB
				if(x->x_copyFileNumber < 255 && timeSinceLast < 200 && x->x_paramPage == 1){
					int loadInfo = x->x_playLayer * 100;
					int fileBank = (x->x_copyFileNumber / 6) + 1;
					int fileSlot = (x->x_copyFileNumber % 6) + 1;
					loadInfo += fileBank * 10;
					loadInfo += fileSlot;
					post("LOADING arbhar scene %d", loadInfo);
					writeToSharedMem(x,SHM_LOAD_SCENE_USB,loadInfo);
					x->x_checkFileProcess = 1;
				} else {
					writeToSharedMem(x,SHM_LOAD_SCENE_USB,0);
				}
				if(x->x_copyLayerTo < 255 && timeSinceLast < 200 && x->x_paramPage == 1){
					int copyInfo = (x->x_playLayer+1) * 100;
					copyInfo += x->x_copyLayerTo;
					writeToSharedMem(x,SHM_LOAD_SCENE_LOCAL,copyInfo);
					x->x_checkFileProcess = 1;
					post("page %d: loading scene %d from local: shmem 107: %d", x->x_paramPage, x->x_copyLayerTo, copyInfo);
				} else {
				//	writeToSharedMem(x,SHM_LOAD_SCENE_LOCAL,0);
				}
				//SAVING ARBHAR SCENE TO USB
				if(x->x_copyFileNumber < 255 && timeSinceLast < 200 && x->x_paramPage == 2){
					int loadInfo = x->x_playLayer * 100;
					int fileBank = (x->x_copyFileNumber / 6) + 1;
					int fileSlot = (x->x_copyFileNumber % 6) + 1;
					loadInfo += fileBank * 10;
					loadInfo += fileSlot;
					post("SAVE arbhar scene %d", loadInfo);
					writeToSharedMem(x,SHM_SAVE_SCENE_USB,loadInfo);
					x->x_checkFileProcess = 1;
				} else {
				//	writeToSharedMem(x,SHM_SAVE_SCENE_USB,0);
				}
				if(x->x_copyLayerTo < 255 && timeSinceLast < 200 && x->x_paramPage == 2){
					int copyInfo = (x->x_playLayer+1) * 100;
					copyInfo += x->x_copyLayerTo;
					writeToSharedMem(x,SHM_SAVE_SCENE_LOCAL,copyInfo);
					x->x_checkFileProcess = 1;
					post("page %d: saving scene %d to local: shmem 108: %d", x->x_paramPage, x->x_copyLayerTo, copyInfo);
				} else {
				//	writeToSharedMem(x,SHM_SAVE_SCENE_LOCAL,0);
				}
			}
		}
		
		//post("|check \\/ mode: %s, shift %d, capture %d, strike %d \n======================", 
		//			getModeName(temp->mode), _getButtonOrder(&temp->shift), _getButtonOrder(&temp->capture), _getButtonOrder(&temp->strike));
		led_shiftMode(x,_getCurrentParamMode(x));
	} else /* in CALIBRATION_MODE or TESTING_MODE*/
	{
		t_buttons *temp = &x->x_buttons;
		static int shiftNo = 0;
		static int captNo = 0;
		static int strikeNo = 0;
				
		_setOrder_shift(temp);
		_setOrder_capture(temp);
		_setOrder_strike(temp);
		
		if(x->x_arbharMode == TESTING_MODE) {
			if(_getButtonOrder(&temp->shift) > 0)
			{
				shiftNo++;
				captNo = 0;
				captNo = 0;
				if(shiftNo > 7)
					strikeNo = 0;
				_setCaptureLed(x,captNo);
				_setStrikeLed(x,strikeNo);
			}
			if(_getButtonOrder(&temp->capture) > 0)
			{
				captNo++;
				if(captNo > 7)
					captNo = 0;
				_setCaptureLed(x,captNo);
			}
			if(_getButtonOrder(&temp->strike) > 0)
			{
				strikeNo++;
				if(strikeNo > 7)
					strikeNo = 0;
				_setStrikeLed(x,strikeNo);
			}
			
			
		}

		post("button pressed in CALIBRATION or TESTING mode: arbhar_mode = %d", x->x_arbharMode);
		post("|check \\/ mode: %s, shift %d, capture %d, strike %d \n======================", 
					getModeName(temp->mode), _getButtonOrder(&temp->shift), _getButtonOrder(&temp->capture), _getButtonOrder(&temp->strike));
	}
}

void tick_processButtonUp(t_arbhar_gpio_tilde *x) {
	if(x->x_arbharMode < CALIBRATION_MODE)
	{
		//post("________/\\_______\n|processing button up event");
		t_buttons *temp = &x->x_buttons;
		//if(temp->mode != PARAM_TOGGLED) {
			if(temp->mode != PARAM_TOGGLED && _getButtonState(&temp->shift) == 0 && _getButtonState(&temp->capture) == 0 && _getButtonState(&temp->strike) == 0) {
				if(_getCurrentParamMode(x) == TRACK_AND_HOLD){
	//				post("TRACK_AND_HOLD: set held values");
					writeFloatToSharedMem(x,SHM_Q_PITCH_HZ,x->x_quantisedTrackAndHoldPitch);
					writeToSharedMem(x,SHM_USING_QUENTISED_PITCH,1);
				}
				if(x->x_protectPlayLayerValue == 0)
					_setWhiteLyrLedPulse(x,0);
				temp->shift.order = 0;
				temp->capture.order = 0; 
				temp->strike.order = 0;
				temp->mode = PERFORMANCE;
				writeToSharedMem(x,SHM_PARAM_TOGGLED,0);
				writeToSharedMem(x,SHM_PREVIEW_FILE,0);
				writeToSharedMem(x,SHM_LAOD_FILE,0);
				_changeParamMode(x,temp->mode);
			}
		//}
		if(x->x_awaitRecording == 1 && temp->capture.prev == 1) {
			//post("*********\nEXECUTE CAPTURE ACTION\n*********");
			_toggleRecordingState(x);
			x->x_awaitRecording = 0;
		}
		if(temp->capture.prev == 1 && x->x_recording == 1 && x->x_captureButtonMode) {
			_setRecordingState(x,0);
		}
		//post("|check /\\ mode: %s, shift %d, capture %d, strike %d \n======================", 
		//			getModeName(temp->mode), temp->shift.order, temp->capture.order, temp->strike.order);
		led_shiftMode(x,_getCurrentParamMode(x));

		if(_getCurrentParamMode(x) == PERFORMANCE){
			x->x_allowOnsetModeChange = 0;
			x->x_lastParamPage = 255;
			writeToSharedMem(x,SHM_PREVIEW_FILE,0);
			writeToSharedMem(x,SHM_LAOD_FILE,0);
			if(x->x_recording < 1){
				t_atom ctlInfo[2];
				SETFLOAT(ctlInfo,0);
				SETFLOAT(ctlInfo+1,142);
				outlet_list(x->g_info_out, gensym("list"),2,ctlInfo);
			}
			//post("returned to PERFORMANCE");
		} else if(_getCurrentParamMode(x) >= PARAM_TOGGLED){
			//if(_getButtonRelease(&temp->shift)) {
				//static uint32_t prevTime = 0;
				//post("*********\nLOAD_SOMETHING\n*********");
				//post("shift time: %d", x->x_dspFrameClock - temp->shift.timePressed);
				//if(x->x_dspFrameClock - temp->shift.timePressed < 255 && x->x_copyLayerTo < 255){
					//int copyInfo = x->x_playLayer * 100;
					//copyInfo += x->x_copyLayerTo;
					//post("COPYING from layer %d to %d: shmem 120: %d", x->x_playLayer, x->x_copyLayerTo, copyInfo);
				//}
				//if(x->x_dspFrameClock - temp->shift.timePressed < 255 && x->x_copyFileNumber < 255){
					//int loadInfo = x->x_playLayer * 100;
					//loadInfo += x->x_copyFileNumber;
					//post("LOADING indo layer %d file no %d: shmem 122: %d", x->x_playLayer, x->x_copyFileNumber, loadInfo);
				//}
				//prevTime = x->x_dspFrameClock;
			//}
			led_PlayPosOff(x);
		}
	} else if (x->x_arbharMode == TESTING_MODE) {
		t_buttons *temp = &x->x_buttons;
		temp->shift.order = 0;
		temp->capture.order = 0; 
		temp->strike.order = 0;
	}
}

void setIgnore(t_button *b, uint8_t val)
{
	b->ignore = val;
}

void releaseButton(t_button *b) {
	b->state = 0;
	b->order = 0;
	b->ignore = 0;
	b->changed = 1;
	post("state: %d", b->state);
}

void getModeFromOrder(t_buttons *temp){
	uint8_t shift, capture, strike;
	shift = _setOrder_shift(temp);
	capture = _setOrder_capture(temp);
	strike = _setOrder_strike(temp);
	
	if(shift == 1 && capture == 2 && strike == 3) {
		temp->mode = PARAM_TOGGLED;
		setIgnore(&temp->shift, 1);
		setIgnore(&temp->capture, 1);
		setIgnore(&temp->strike, 1);
	}
	else if(shift == 1 && capture == 2 && strike == 0) {
		temp->mode = PARAM_MOMENTARY;
		setIgnore(&temp->shift, 1);
		setIgnore(&temp->capture, 1);
	}
	else if(shift == 1 && capture == 0 && strike == 0) {
		temp->mode = PARAM_SHIFT;
		setIgnore(&temp->shift, 1);
	}
	else if(shift == 0 && capture == 0 && strike == 0) {
		temp->mode = PERFORMANCE;
	}
}

void tick_setBCM2835(t_arbhar_gpio_tilde *x)
{ 
	_setTriggerOut(0);
	//post("setting trugger low");
	writeToSharedMem(x,SHM_TRIG_OUT_VOL,0);
}

void tick_getBCM2835(t_arbhar_gpio_tilde *x)
{ 
	if(readFromSharedMem(x,SHM_FILE_PROCESSING) == 0)
	{
		if(x->x_arbharMode != CALIBRATION_MODE)
			_getAllAdcs(x);
		else
			_getAllAdcsDuringCalibration(x);
	}
	//button state container
	t_buttons *temp = &x->x_buttons;
	
	uint8_t captureCV = readFromSharedMem(x,SHM_CPT_CV_VAL); // !bcm2835_gpio_lev(CAPTURE_CV);
	uint8_t strikeCV = readFromSharedMem(x,SHM_STR_CV_VAL); // !bcm2835_gpio_lev(STRIKE_CV);
	//if (captureCV > 0)
	//	writeToSharedMem(x, SHM_CPT_CV_VAL, 0);
	//if (strikeCV > 0)
	//	writeToSharedMem(x, SHM_STR_CV_VAL, 0);
	//post("strikeCV: %d", strikeCV);
	
	if(x->x_arbharMode < CALIBRATION_MODE) {
		//post("strikeCV %d", strikeCV);
		uint8_t recCvToggle = 0;
		static uint8_t pCaptCV = 0;
		if(pCaptCV != captureCV) {
			writeToSharedMem(x, SHM_CPT_CV, captureCV);
		//	post("dsp frame: %d %d", captureCV, x->x_dspFrameClock);
			if(x->x_captureCvAsGate == 1) {
				if(x->x_recording){
					if(captureCV > 0){
						//post("recording already");
					} else {
						_setRecordingState(x,0);
					}	
				} else {
					if(captureCV > 0){
						if(x->x_accumRecording > 0)
							_setRecordingState(x,1);
						else
							_setRecordingStateWithReset(x,1);
					}
					else {
						_setRecordingState(x,0);
					}	
						
				}
			} else if (x->x_captureCvAsGate == 2) {
				if(captureCV > 0){
					//post("recording already");
					if(x->x_recording > 0){
						_setRecordingState(x,0);
						//_toggleRecordingState(x);
						x->x_recordingPos = 0;
						clock_delay(x->x_scheduleRecordingStart, 25);
					} else if (_getCurrentParamMode(x) == PERFORMANCE){
						
						_setCaptureLed(x,WHITE_DIM);
						clock_delay(x->x_captureCvLed, 25);
					}
				}
			} else {
				if(captureCV > 0){
					_toggleRecordingState(x);
				}
			}
			//post("captureCV");
			pCaptCV = captureCV;
		}
		if(_getCurrentParamMode(x) == PERFORMANCE) {
		led_controlForRecording(x);
		}
	
		static uint8_t pStrikeCV = 0;
		
		
		if(pStrikeCV != strikeCV) {
			
			//if(strikeCV == 0) {
			//	writeToSharedMem(x, SHM_STR_CV_VAL, 0);
			//}
			//if(readFromSharedMem(x, SHM_STR_CV_VAL)){
			//	clock_delay(x->x_strikeCvLed, 0);
				//clock_delay(x->x_strikeTrigger, x->x_strikeCvDelay);
			//	static int pTime = 0;
				//post("strikeCV: %d", x->x_dspFrameClock - pTime);
			//	pTime = x->x_dspFrameClock;
			if(strikeCV && x->x_followMode) {
				x->x_followPosition = 0;	
			}
			pStrikeCV = strikeCV;
		}
		
	} 

	
	
	//post("start: mode: %d, shift %d, capture %d, strike %d", temp->mode, temp->shift.state, temp->capture.state, temp->strike.state);
	
	uint8_t shift = shiftFilter(bcm2835_gpio_lev(SHIFT));
	_getButton(x, &temp->shift, shift);
	
	uint8_t capture = captureFilter(bcm2835_gpio_lev(CAPTURE_BUTTON));
	_getButton(x, &temp->capture, capture);
	
	uint8_t strike = strikeFilter(bcm2835_gpio_lev(STRIKE_BUTTON));
	_getButton(x, &temp->strike, strike);

	if(x->x_arbharMode < CALIBRATION_MODE) {
		static int pHoldVal = 0;
		int holdVal = readFromSharedMem(x,SHMEM_CURRENT_HOLD_VALUE);
		int directTriggerVal = 0;
		if(x->x_useHoldToSwitch < 1) {
			directTriggerVal = readFromSharedMem(x,SHMEM_ONSET_FOR_CAPTURE);
			//if(directTriggerVal > 0)
				//post("receiving additional trigger to initiate recording");
		}
		//ost(" recording? 106:  %d", directTriggerVal);
		//x->adc_samp_rate = ADC_SAMP_RATE;
		//if(x->x_currentOnsetMode->captureCtrl && x->x_accumRecording == 0 && x->x_stereo < 1) {
			//if((holdVal > 0 && pHoldVal != holdVal) || readFromSharedMem(x,106) > 0){
				//post("initiate recording");
				//writeToSharedMem(x,SHMEM_ONSET_FOR_CAPTURE,0);
			//}
		//}
		if(x->x_currentOnsetMode->captureCtrl && x->x_accumRecording == 0 && x->x_stereo < 1) {
			//_setTriggerOut(readFromSharedMem(x,SHM_HOLD_ACTIVE));
			
			if((holdVal > 0 && pHoldVal != holdVal) || directTriggerVal > 0 ){
				if(x->x_recording > 0)
					_toggleRecordingState(x);
				if(x->x_recording == 0)
					clock_delay(x->x_scheduleRecordingStart, 50);
			// post(" recording? 106:  %d", directTriggerVal);
			}
			pHoldVal = holdVal;
		} else if(x->x_currentOnsetMode->captureCtrl && x->x_accumRecording == 1 && x->x_stereo < 1) {
				if((pHoldVal != holdVal) || directTriggerVal > 0) {
				if(holdVal > 0  || readFromSharedMem(x,SHMEM_ONSET_FOR_CAPTURE) > 0){
					_setRecordingState(x,1);
					post("continue recording");
				}
				else if(holdVal == 0  && directTriggerVal == 0){
					post("pause recording");
					_setRecordingState(x,0);
				}
			}
			pHoldVal = holdVal;
			
		}
		writeToSharedMem(x,SHMEM_ONSET_FOR_CAPTURE,0);
	} else {
		x->adc_samp_rate = 5;
		x->strike_samp_rate = 3;
	}
	//post("getFromGpio");
	clock_delay(x->x_getFromGpio, x->adc_samp_rate);
}

void _setWhiteLayerLeds(t_arbhar_gpio_tilde *x, t_float slot, t_float bank)
{
	//x->whiteLayerValue[0] = (uint8_t)bank;
	//x->whiteLayerValue[1] = 0;//(uint8_t)slot;
	//x->orangeLayerValue[0] = 0;//(uint8_t)bank;
	//x->orangeLayerValue[1] = (uint8_t)slot;
	
	x->orangeLayerValue = (uint8_t)bank;
	x->whiteLayerValue = (uint8_t)slot;
	
	
}


void _setCopyOrFileSlot(t_arbhar_gpio_tilde *x, uint8_t slot)
{
	if(slot < 7) {
		x->x_copyLayerTo = slot;
		x->x_copyFileNumber = 255;
		//post("copy from %d to %d", x->x_recLayer, x->x_copyLayerTo);
	}
	else {
		x->x_copyFileNumber = slot - 7;
		x->x_copyLayerTo = 255;
		//post("selected file to load: %d", x->x_copyFileNumber);
	}
}

t_float _getLayerCopyAndLibraryLoadSlot(t_arbhar_gpio_tilde *x)
{
	static t_float lastPotVal = 0;
	int availableSlots = readFromSharedMem(x,SHM_NO_OF_SLOTS);
	lastPotVal = (t_float)quantisePot(x->x_ch[MCP_CH_SEQUENTIALLY[_LYP]].avg, availableSlots);
	int offset = 0;
	if(availableSlots <= 6)
		offset = 36;
	int slotNo = (42-offset)-lastPotVal;
	slotNo = slotNo < 0 ? 0 : slotNo;
	_setCopyOrFileSlot(x,slotNo);
	return lastPotVal;
}


void led_setLayerFileSlots(t_arbhar_gpio_tilde *x, t_float layerPot)
{
	static int prevId = 255;
	int availableSlots = readFromSharedMem(x,SHM_NO_OF_SLOTS) - 1;

		int getId = availableSlots - (int)layerPot;
		int getPage = x->x_paramPage;
		if(prevId != getId){
			prevId = getId;
		}
		_setWhiteLayerLeds(x,FILE_SLOT_LED[getId][0],FILE_SLOT_LED[getId][1]);
		t_atom ctlInfo[4];
		SETFLOAT(ctlInfo, x->orangeLayerValue);
		SETFLOAT(ctlInfo+1, 147);
		SETFLOAT(ctlInfo+2, x->whiteLayerValue);
		SETFLOAT(ctlInfo+3, 146);
		outlet_list(x->toSerial, gensym("list"),4,ctlInfo);
		clock_delay(x->x_layerLedControl, 25);
		
		
}

void led_setSelectedLayerLed(t_arbhar_gpio_tilde *x)
{
	t_atom ctlInfo[4];
	uint8_t play = 1;
	uint8_t rec = 1;
	uint8_t shiftPlay = 0;
	uint8_t shiftRec = 7 - (x->x_recLayer + 1);
	if(x->x_omega < 1) 
	{
		shiftPlay = 7 - (x->x_playLayer + 1); // (uint8_t)_getPlayLayer(x);
		shiftRec = 7 - (x->x_recLayer + 1);
	}
	if(x->x_omega == 1 && x->x_playRecCoupled > 0)
		shiftRec = 0;
		
		SETFLOAT(ctlInfo, play << shiftPlay);
		SETFLOAT(ctlInfo+1, 146);
		SETFLOAT(ctlInfo+2, rec << shiftRec);
		SETFLOAT(ctlInfo+3, 147);
		if(x->x_arbharMode < CALIBRATION_MODE) 
			outlet_list(x->toSerial, gensym("list"),4,ctlInfo);
		//clock_delay(x->x_layerLedControl, 25);
}



void _setHoldValue(t_arbhar_gpio_tilde *x, t_float val) {
	if(_getCurrentParamMode(x) == PERFORMANCE) {
		t_float potVal = val;
		t_float cvVal = readFromSharedMem(x,SHM_MOD_HOLD) - 2048;
		t_float holdVal = potVal + cvVal;
		//post("holdVal: %f", holdVal);
		holdVal = holdVal >= 4095 ? 4095 : holdVal <= 0 ? 0 : holdVal; 
		t_float holdValInMS = ((4095 - holdVal) / 4095);
		holdValInMS = holdValInMS * holdValInMS;
		holdValInMS *= 10000; 
		holdValInMS = holdValInMS < 0 ? 0 : holdValInMS;
		int holdAsInt = (int)holdValInMS;
		static int pVal = 0;
		
		
		
		if(pVal != holdAsInt) {
			writeToSharedMem(x,SHM_HOLD_AS_INT,(float)holdAsInt);
			pVal = holdAsInt;
			//post("hold value: %d", holdAsInt);
		}
	}
}

void _setPhaseSwitch(t_arbhar_gpio_tilde *x, t_float val) {
	static uint8_t enable = 0;
	static uint8_t switch_state = 0;
	if(_getCurrentParamMode(x) == PARAM_MOMENTARY) {
		if(val < 3800 && val > 300)
			{
				enable = 1;
			}
		else if (val >= 3800 && enable == 1){
			switch_state = 0;
			enable = 0;
			writeToSharedMem(x,SHM_PHASE_SHIFT,switch_state);
			post("check phase switch: %d", switch_state);
		}
		else if (val <= 300 && enable == 1){
			switch_state = 1;
			enable = 0;
			writeToSharedMem(x,SHM_PHASE_SHIFT,switch_state);
			post("check phase switch: %d", switch_state);
		}
		//post("check phase switch: %f", val);
		if(enable == 0) {
			static uint8_t pState = 255;
			if(pState != switch_state) {
				t_atom configurationInfo[2];
				SETSYMBOL(configurationInfo, gensym("OutputPhaseSwitch"));
				SETSYMBOL(configurationInfo, gensym("PhaseSwitch"));
				SETFLOAT(configurationInfo+1, switch_state);
				//SETFLOAT(configurationInfo+2, v);
				if(x->x_arbharMode < CALIBRATION_MODE)
					outlet_list(x->config_out, gensym("list"),2,configurationInfo);
				pState = switch_state;
			}
		}
	} else {
		enable = 0;
	}
	
}

void _setStereoSwitch(t_arbhar_gpio_tilde *x, t_float val) {
	static uint8_t enable = 0;
	static uint8_t switch_state = 0;
	if(_getCurrentParamMode(x) == PARAM_MOMENTARY) {
		if(val < 3800 && val > 300)
			{
				enable = 1;
			}
		else if (val >= 3800 && enable == 1){
			switch_state = 0;
			x->x_stereo = switch_state;
			enable = 0;
			writeToSharedMem(x,SHM_STEREO_INPUT,switch_state);
			//post("check stereo switch: %d", switch_state);
		}
		else if (val <= 300 && enable == 1){
			switch_state = 1;
			x->x_stereo = switch_state;
			enable = 0;
			writeToSharedMem(x,SHM_STEREO_INPUT,switch_state);
			//post("check stereo switch: %d", switch_state);
		}
		if(enable == 0) {
			static uint8_t pState = 255;
			if(pState != switch_state) {
				t_atom configurationInfo[2];
				SETSYMBOL(configurationInfo, gensym("InputMode"));
				SETFLOAT(configurationInfo+1, switch_state);
				//SETFLOAT(configurationInfo+2, v);
				if(x->x_arbharMode < CALIBRATION_MODE)
					outlet_list(x->config_out, gensym("list"),2,configurationInfo);
				pState = switch_state;
			}
		}
	//post("check phase switch: %f", val);
	} else {
		enable = 0;
	}
	
}

void _setCaptureToggleGateSwitch(t_arbhar_gpio_tilde *x, t_float val) {
	static uint8_t enable = 0;
	static uint8_t switch_state = 0;
	if(_getCurrentParamMode(x) == PARAM_MOMENTARY) {
		if(val < 3800 && val > 300)
			{
				enable = 1;
			}
		else if (val >= 3800 && enable == 1){
			switch_state = 0;
			enable = 0;
			x->x_captureCvAsGate = 1 - switch_state;
			//post("check capture toggle/gate: %d", switch_state);
		}
		else if (val <= 300 && enable == 1){
			switch_state = 1;
			enable = 0;
			x->x_captureCvAsGate = 1 - switch_state;
			//post("check capture toggle/gate: %d", switch_state);
		}
		//post("capture gate (0) / toggle (1): %d", x->x_captureCvAsGate);
		if(enable == 0) {
			static uint8_t pState = 255;
			if(pState != switch_state) {
				t_atom configurationInfo[2];
				SETSYMBOL(configurationInfo, gensym("CaptureCVMode"));
				SETFLOAT(configurationInfo+1, switch_state);
				//SETFLOAT(configurationInfo+2, v);
				if(x->x_arbharMode < CALIBRATION_MODE)
					outlet_list(x->config_out, gensym("list"),2,configurationInfo);
				pState = switch_state;
			}
		}
	} else {
		enable = 0;
	}
}

void layerCopyAndLibraryLoadingSlot(t_arbhar_gpio_tilde *x, int val)
{
	int availableSlots = readFromSharedMem(x,SHM_NO_OF_SLOTS);
	int copyToLayer = -1;
	int loadFromLibrary = -1;
	int libraryBankSlot[2] = {0, 0};
	if(val <= 6)
		copyToLayer = val;
	else if(val >= 7 && availableSlots > 6) {
		loadFromLibrary = val - 6;
		libraryBankSlot[0] = ((loadFromLibrary - 1) / 6) + 1;
		libraryBankSlot[1] = ((loadFromLibrary - 1) % 6) + 1;
	}
}

void tick_layerLedControl(t_arbhar_gpio_tilde *x) 
{	
	//post("check");
	static int initFrame = 75;
	static int showForNoFrames = 300;
	static int showOnsetModeCount = 0;
	if(x->x_showOnsetMode == 1)
	{
		initFrame = 0;
		if(showOnsetModeCount > 0)
			showForNoFrames = 100;
		showOnsetModeCount++;
		x->x_showOnsetMode = 0;
	}
	if(initFrame < showForNoFrames)
	{
		//post("onsetMode: %d for frames %d of %d",x->x_currentOnsetMode->name, initFrame, showForNoFrames);
		led_onsetModeControl(x,x->x_currentOnsetMode->name);
		initFrame++;
		clock_delay(x->x_layerLedControl, 15);
	}
	else
	{
	 if(x->x_arbharMode != CALIBRATION_MODE)
	{
		if(_getCurrentParamMode(x) >= PARAM_TOGGLED){
			static int prevSlotNo = -1;
			int copyLibrarySlot = _getLayerCopyAndLibraryLoadSlot(x);
			int currentSlotNo = 42-copyLibrarySlot;
			led_setLayerFileSlots(x, copyLibrarySlot); 
			if(prevSlotNo != currentSlotNo || readFromSharedMem(x,SHM_CHECK_USB) == 1){
				layerCopyAndLibraryLoadingSlot(x,currentSlotNo);
			}
			prevSlotNo = currentSlotNo;
			static int resetLed = 0;
			if (readFromSharedMem(x,SHM_FILE_PROCESSING) > 0 || readFromSharedMem(x,SHM_SHMEM_COPY) > 0) {
				//post("animateFileActivity");
				animateFileActivityBusy(x);
				resetLed = 1;
			} else {
				if(resetLed) {
					post("resetPosLed");
					resetLed = 0;
					t_atom ctlInfo[2];
					SETFLOAT(ctlInfo,18);
					SETFLOAT(ctlInfo+1,143);
					outlet_list(x->g_info_out, gensym("list"),2,ctlInfo);
				}
			}
		} 
		else if (_getCurrentParamMode(x) == PERFORMANCE) {
			led_setSelectedLayerLed(x);
			_setHoldValue(x, x->x_ch[MCP_CH_SEQUENTIALLY[_HOL]].val);
		} 
		else if (_getCurrentParamMode(x) == PARAM_SHIFT) {
			led_setSelectedLayerLed(x);
		}
		else if (_getCurrentParamMode(x) == PARAM_MOMENTARY) {
			_setOnsetMode(x,x->x_ch[MCP_CH_SEQUENTIALLY[_LYP]].val);
		}
		else if(_getCurrentParamMode(x) == TRACK_AND_HOLD)
		{
			int quantVal = (int)x->x_quantisedTrackAndHoldPitch + 24;
			static int pQuantVal = 0;
			if(pQuantVal != quantVal)
			{
				int whiteLed = 0;
				int yellowLed = 0;
				whiteLed = (quantVal % 12);
				yellowLed = (quantVal % 12);
				int ctlWhite = 1;
				int ctlYellow = 1;
				if(whiteLed != 0) {
					whiteLed = whiteLed > 6 ? 0 : whiteLed;
					yellowLed = yellowLed > 6 ? yellowLed - 6 : 0;
					 ctlWhite = 64 >> (whiteLed - 1);
					 ctlYellow = 1 << (6 - yellowLed);
					ctlYellow = ctlYellow > 32 ? 0 : ctlYellow == 1 ? 0 : ctlYellow;
					//post("yellowLed: %d", yellowLed);
					ctlWhite = ctlWhite > 64 ? 0 : ctlWhite;
				}
				t_atom ctlInfo[4];
				SETFLOAT(ctlInfo, ctlWhite);
				SETFLOAT(ctlInfo+1, 146);
				SETFLOAT(ctlInfo+2, ctlYellow);
				SETFLOAT(ctlInfo+3, 147);
				if(x->x_arbharMode < CALIBRATION_MODE) 
					outlet_list(x->toSerial, gensym("list"),4,ctlInfo);
				//post("quatVal: %d", (int)x->x_quantisedTrackAndHoldPitch);
				pQuantVal = quantVal;
			}
		}
		_setPhaseSwitch(x,x->x_ch[MCP_CH_SEQUENTIALLY[_HOL]].val);
		//t_float pFollowSwitch = (t_float)x->x_followMode;
		//t_float cFollowSwitch = _setFollowModeSwitch(x, x->x_ch[MCP_CH_SEQUENTIALLY[_SCP]].val);
		_setFollowModeSwitch(x, x->x_ch[MCP_CH_SEQUENTIALLY[_SCP]].val);
		//if(pFollowSwitch != cFollowSwitch) {
		//	post("setting follo mode? %d - %d",pFollowSwitch, cFollowSwitch);
		//	_setFollowMode(x,cFollowSwitch);
		//}
		//pFollowSwitch = cFollowSwitch;
		_setStereoSwitch(x,x->x_ch[MCP_CH_SEQUENTIALLY[_TEX]].val);
		_setCaptureToggleGateSwitch(x,x->x_ch[MCP_CH_SEQUENTIALLY[_DUB]].val);
	
		static int frame = 0;
		frame++;
		if(frame > 5){
			led_menuPagesIndicator(x,(x->x_paramMode >= PARAM_TOGGLED ? 1 : 0)); //page indicator is working
			frame = 0;
		}
		
		if (_getCurrentParamMode(x) <= PARAM_MOMENTARY)
			clock_delay(x->x_layerLedControl, 15);
			
	}
}
}

void animateFileActivityBusy(t_arbhar_gpio_tilde *x)
{
	static int led = 19;
	static int add = 1;
	//static int frameCount = 0;
	//if(frameCount % 2 == 0) {
		t_atom ctlInfo[4];
		SETFLOAT(ctlInfo,1);
		SETFLOAT(ctlInfo+1,142);
		SETFLOAT(ctlInfo+2,led);
		SETFLOAT(ctlInfo+3,143);
		led += add;
		if(led <= 72 && led >= 0) {
			outlet_list(x->g_info_out, gensym("list"),4,ctlInfo);
		}
		if (led > 62){
			led = 19;
			add = 1;
		} else if (led < 0)
			add = 1;
	//}
	//frameCount++;
	//if(frameCount > 2)
	//	frameCount = 0;
	
}



/**
 * this is the core of the object
 * this perform-routine is called for each signal block
 * the name of this function is arbitrary and is registered to Pd in the
 * pan_tilde_dsp() function, each time the DSP is turned on
 *
 * the argument to this function is just a pointer within an array
 * we have to know for ourselves how many elements inthis array are
 * reserved for us (hint: we declare the number of used elements in the
 * pan_tilde_dsp() at registration
 *
 * since all elements are of type "t_int" we have to cast them to whatever
 * we think is apropriate; "apropriate" is how we registered this function
 * in pan_tilde_dsp()
 */
t_int *arbhar_gpio_tilde_perform(t_int *w)
{
  t_arbhar_gpio_tilde *x = (t_arbhar_gpio_tilde *)(w[1]);
  t_sample  *out =    (t_sample *)(w[2]);
  int          n =           (int)(w[3]);
  //int i;

  //if(_getCurrentParamMode(x) == PERFORMANCE) {
		//led_ScanLengthControl(x);
		//led_PlayPosControl(x);
		//led_controlForRecording(x);
	//}
	
	_getCaptureCvToShMem(x);
	
	
	if(x->x_arbharMode != CALIBRATION_MODE)
	{
		if(x->x_followMode){
		  x->x_followPosition += n * x->x_followSpeed;
		  int followLengthInSamp = 480000;
			if(x->x_followLengthAsHold)
				followLengthInSamp = readFromSharedMem(x,SHM_HOLD_AS_INT) * 48;
		  if(x->x_followLoop){
			  if(x->x_followPosition > followLengthInSamp - 1){
				if(x->x_currentOnsetMode->followModeEOC){
					_setTriggerOut(1);
					clock_delay(x->x_setOnGpio, TRIGGER_LENGTH);
				}
				x->x_followPosition = 0;
			}
			  else if(x->x_followPosition < 0 && x->x_followSpeed < 0)
				x->x_followPosition = followLengthInSamp;
			} else {
				if(x->x_followPosition >= followLengthInSamp) {
					x->x_followPosition = followLengthInSamp;
					//post("follow pos: %d scanCV=%d mid=%d", (int)x->x_followPosition, x->x_ch[2].val, x->x_ch[2].mid);
				}
			}
			//post("pos: %d", (int)x->x_followPosition);
		}
	  x->x_dspFrameClock++;
	  if(x->x_recording > 0){
		x->x_recordingPos = x->x_recordingPos + 64;
		//post("pos: %d", (int)x->x_recordingPos);
		if(x->x_recordingPos > 624000)
			_toggleRecordingState(x); //x->x_recording = 0;
	  }
	}
  //for(i=0; i<n; i++)
    //{
      //out[i]=x->x_gpio_ins;
    //}

  /* return a pointer to the dataspace for the next dsp-object */
  return (w+4);
}


/**
 * register a special perform-routine at the dsp-engine
 * this function gets called whenever the DSP is turned ON
 * the name of this function is registered in pan_tilde_setup()
 */
void arbhar_gpio_tilde_dsp(t_arbhar_gpio_tilde *x, t_signal **sp)
{
	
	  bcm2835_spi_begin();
  bcm2835_spi_setClockDivider(BCM2835_SPI_CLOCK_DIVIDER_128);
   
  dsp_add(arbhar_gpio_tilde_perform, 3, x,
          sp[0]->s_vec, sp[0]->s_n);
}

/**
 * this is the "destructor" of the class;
 * it allows us to free dynamically allocated ressources
 */
void arbhar_gpio_tilde_free(t_arbhar_gpio_tilde *x)
{
	bcm2835_spi_end();
	bcm2835_close();
	
  if ( x->share_memory ){
    if ( shmdt (x->share_memory) == -1) error("shmdt failed at %x", x->share_memory);
  }
  x->share_memory=NULL;

  int shm_id = x->segment_id;
  struct shmid_ds shm_desc;
  if(shm_id>0){
    if (shmctl(shm_id,IPC_STAT, &shm_desc) != -1){
      if(shm_desc.shm_nattch<=0){
        if (shmctl(shm_id,IPC_RMID, &shm_desc) == -1) error("shmctl remove failed for %d", shm_id);
      }
    }
  }
  shm_id=0;

  /* free any ressources associated with the given outlet */
  outlet_free(x->x_out);
  outlet_free(x->g_info_out);
  outlet_free(x->layerBufOp);
  outlet_free(x->toSerial);
  outlet_free(x->eeprom_out);
  outlet_free(x->config_out);
  outlet_free(x->calibrated_out);
  
  if (x->x_getFromGpio) clock_free(x->x_getFromGpio);
  if (x->x_getStrike) clock_free(x->x_getStrike);
  if (x->x_setOnGpio) clock_free(x->x_setOnGpio);
  if (x->x_playPosLedOff) clock_free(x->x_playPosLedOff);
  if (x->x_layerLedControl) clock_free(x->x_layerLedControl);
  if (x->x_strikeLed) clock_free(x->x_strikeLed);
  if (x->x_strikeCvLed) clock_free(x->x_strikeCvLed);
  if (x->x_strikeTrigger) clock_free(x->x_strikeTrigger);
  if (x->x_captureCvLed) clock_free(x->x_captureCvLed);
  if (x->x_buttonDown) clock_free(x->x_buttonDown);
  if (x->x_buttonUp) clock_free(x->x_buttonUp);
  if (x->x_scheduleRecordingStart) clock_free(x->x_scheduleRecordingStart);
  if (x->x_clockTriggeringGrains) clock_free(x->x_clockTriggeringGrains);
  if (x->x_bpmClock) clock_free(x->x_bpmClock);

}


void _setPresetValues(t_arbhar_gpio_tilde* x, t_symbol *s, t_int argc, t_atom *argv){
	char presetName[50];
	int n = 0;
	atom_string(argv+n,presetName,50);
	if(argc != 0 && argc % 2 == 0) {
		//post("valid preset");
		x->x_showOnsetMode = 1;
		//post("%d values given in %s = ",argc-1, presetName);
		for(int i = 0; i<argc/2;i++) {
			// char presetName[50];
			// atom_string(argv+n,presetName,50);
			t_float value = atom_getfloat(argv+(n+1));
			//post("set preset %s",presetName);
			//post("set value %f",value);
			n = n + 2;
			if(strcmp(presetName, "LoadConfiguration:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_LOAD_CONF,(int)value);
			}
			else if(strcmp(presetName, "ModCV:") == 0){
				post("set %s = %f",presetName, value);
				post("value = %f", value);
				_setModCVMode(x,value);
			} 
			else if(strcmp(presetName, "AdcSpeed:") == 0){
				post("set %s = %f",presetName, value);
				post("value = %f", value);
				x->main_adc_samp_rate = value;
				x->adc_samp_rate = value;
			} 
			else if(strcmp(presetName, "PanningDefaultValue:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_PANNING,(-409.6 * value) + 2048); // (-409.6 * value) + 2048 is to convert Volt value into the 12bit
			}
			else if(strcmp(presetName, "PanningDefaultValueInPerCent:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_PANNING,(-20.48 * value) + 2048); // (-20.48 * value) + 2048 is to convert % value into the 12bit
			}
			else if(strcmp(presetName, "HoldDefaultValue:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_HOLD,(-409.6 * value) + 2048); // (-409.6 * value) + 2048 is to convert Volt value into the 12bit
			}
			else if(strcmp(presetName, "ReverbDefaultValue:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_REVERB,(-409.6 * value) + 2048); // (-409.6 * value) + 2048 is to convert Volt value into the 12bit
			}
			else if(strcmp(presetName, "ReverbDefaultValueInPerCent:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_REVERB,(-20.48 * value) + 2048); // (-20.48 * value) + 2048 is to convert % value into the 12bit
			}
			else if(strcmp(presetName, "ReverbReset:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_RESET_REV,(int)value);
			}
			else if(strcmp(presetName, "EffectOrder:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_EFFECT_ORDER,(int)value);
			}
			else if(strcmp(presetName, "DelayDefaultValue:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_DELAY,(-409.6 * value) + 2048); // (-409.6 * value) + 2048 is to convert Volt value into the 12bit
			}
			else if(strcmp(presetName, "DelayDefaultValueInPerCent:") == 0){
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_MOD_DELAY,(-20.48 * value) + 2048); // (-20.48 * value) + 2048 is to convert % value into the 12bit
			}
			else if(strcmp(presetName, "InputMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_stereo = (uint8_t)value;
				writeToSharedMem(x,SHM_STEREO_INPUT,x->x_stereo);
			}
			else if(strcmp(presetName, "OutputPhaseSwitch:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_PHASE_SHIFT,(int)value);
			}
			else if(strcmp(presetName, "PhaseSwitch:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_PHASE_SHIFT,(int)value);
			}
			else if(strcmp(presetName, "CaptureCvMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_captureCvAsGate = (uint8_t)value;
			}
			else if(strcmp(presetName, "CaptureCVMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_captureCvAsGate = (uint8_t)value;
			}
			else if(strcmp(presetName, "OnsetMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_currentOnsetMode = &x->x_onsetModes[(uint8_t)value]; 
				_setPlusLed(x->x_currentOnsetMode->plusLedColour); //causes segmentation fault in arbhar_gpio_tilde_new!!
			}
			else if(strcmp(presetName, "StrikeButtonToTrigger:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_strikeToTrigger = (uint8_t)value;
			}
			else if(strcmp(presetName, "WavetableCentreFrequency:") == 0) {
				post("set %s = %f",presetName, value);
				writeFloatToSharedMem(x,SHM_WT_CENTRE_FREQ,value);
			}
			else if(strcmp(presetName, "StrikeCvDelay:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_strikeCvDelay = value;
				writeFloatToSharedMem(x,SHM_STR_CV_DELAY,value);
			}
			else if(strcmp(presetName, "StrikeCVDelay:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_strikeCvDelay = value;
				writeFloatToSharedMem(x,SHM_STR_CV_DELAY,value);
			}
			else if(strcmp(presetName, "RandomAmpWithRandomIntensity:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_AMP_RAND,value);
			}
			else if(strcmp(presetName, "RandomTimingWithRandomIntensity:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_TIME_RAND,value);
			}
			else if(strcmp(presetName, "RandomDistance:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_DISTANCE_RAND,value);
			}
			else if(strcmp(presetName, "FollowMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followMode = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_MODE,(int)x->x_followMode);
				if(value < 1) {
					clock_delay(x->x_strikeLed,0);
				}
				x->x_followPosition = 0;
			}
			//FollowSpeedBiDirectional
			else if(strcmp(presetName, "FollowSpeedBiDirectional:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followBiDirectional = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_DIRECT,x->x_followBiDirectional);
			}
			else if(strcmp(presetName, "FollowSpeedDirection:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followBiDirectional = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_DIRECT,x->x_followBiDirectional);
			}
			//FollowPositionOffset
			else if(strcmp(presetName, "FollowPositionOffset:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followPosOffset = value;
			}
			else if(strcmp(presetName, "FollowScanOffset:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followPosOffset = value;
			}
			else if(strcmp(presetName, "FollowPositionOffsetWithScanCV:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followPosOffsetByScanCV = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_SCAN_OFFSET,(uint8_t)x->x_followPosOffsetByScanCV);
			}
			else if(strcmp(presetName, "FollowScanOffsetWithScanCV:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followPosOffsetByScanCV = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_SCAN_OFFSET,(uint8_t)x->x_followPosOffsetByScanCV);
			}
			//FollowLoop
			else if(strcmp(presetName, "FollowLoop:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followLoop = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_LOOP,x->x_followLoop);
			}
			//FollowSetLoopLengthWithHold
			else if(strcmp(presetName, "FollowSetLoopLengthWithHold:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_followLengthAsHold = (uint8_t)value;
				writeToSharedMem(x,SHM_FOLLOW_LOOP_WITH_HOLD,x->x_followLengthAsHold);
			}
			else if(strcmp(presetName, "FollowFadeInTime:") == 0)
				post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "FollowModeScanCv:") == 0)
				post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "PlayRecCoupled:") == 0)
				post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "MidiEnable:") == 0)
				post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "GrainNoUsedByMidi:") == 0)
				post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "AccumulateRecordingsInLayer:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_accumRecording = (uint8_t)value;
			}
			else if(strcmp(presetName, "AccumulativeCaptureMode:") == 0) {
				post("set %s = %f",presetName, value);
				//_toggleAccumRecording(x,0);
				x->x_accumRecording = (uint8_t)value;
				if(x->x_accumRecording > 0) {
					//_toggleAccumRecording(x,-1);
					_setCaptureLed(x,AMBER_FLASHING);
				} else {
					
					_setCaptureLed(x,WHITE_AMBER_OFF);
				}
				writeToSharedMem(x, SHM_ACCUM_REC, x->x_accumRecording);
			}
			else if(strcmp(presetName, "LoopPlaybackInFollowMode:") == 0)
				post("set %s = %f",presetName, value);
			//else if(strcmp(presetName, "BidirectionalSpeedInFollowMode:") == 0)
				//post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "AnalogEmulationOfOnsetInput:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_EMULATE_ANALOG,(int)value);
			}
			else if(strcmp(presetName, "AnalogEmulation:") == 0) {
				post("set %s = %f",presetName, value);
				writeToSharedMem(x,SHM_EMULATE_ANALOG,(int)value);
			}
			else if(strcmp(presetName, "GrainPanningInReverbMode:") == 0)
				post("set %s = %f",presetName, value);
			else if(strcmp(presetName, "ActivateCaptureOnButtonUp:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_recOnButtonUp = (uint8_t)value;
			}
			else if(strcmp(presetName, "CaptureButtonAsGate:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_captureButtonMode = (uint8_t)value;
				if(x->x_captureButtonMode)
					x->x_recOnButtonUp = 0;
			}
			else if(strcmp(presetName, "CaptureButtonMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_captureButtonMode = (uint8_t)value;
				if(x->x_captureButtonMode)
					x->x_recOnButtonUp = 0;
			}
			else if(strcmp(presetName, "LinkAccumulativeRecordingCaptureAsGate:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_linkAccumCaptureAsGate = (uint8_t)value;
			}
			else if(strcmp(presetName, "LinkAccumlativeCaptureModeToCaptureButtonMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_linkAccumCaptureAsGate = (uint8_t)value;
			}
			else if(strcmp(presetName, "EnableClockedModeSwitch:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_enableClockedModeSwitch = (uint8_t)value;
			}
			else if(strcmp(presetName, "ClockedMode:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_internalBpmClock = (t_int)value;
				if(x->x_internalBpmClock > 0){
					clock_delay(x->x_bpmClock, 2000.f);
				}
				writeToSharedMem(x,140,x->x_internalBpmClock);
			}
			else if(strcmp(presetName, "ClockBPM:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_bpm = value;
			}
			else if(strcmp(presetName, "InputClockDivision:") == 0) {
				post("set %s = %f",presetName, value);
				x->x_inputClockDivision = value;
			}
			else if(strcmp(presetName, "ClockSetsGrainLength:") == 0) {
				// clock_sets_length
				post("set %s = %f",presetName, value);
				x->clock_sets_length = value;
			}
			if(strcmp(presetName, "ClockDivisions:") == 0) {
				x->clockDivLength = argc-1;
				//post("%d clock divisions given in %s",x->clockDivLength, presetName);
				for(int i=0; i< argc-1; ++i) {
					x->clockDiv[i] = atom_getfloat(argv+(i+1));
				}
			}
			else if(strcmp(presetName, "ClockMultiplications:") == 0) {
				x->clockMultLength = argc-1;
				//post("%d clock multiples given in %s ",x->clockMultLength, presetName);
				for(int i=0; i< argc-1; ++i) {
					x->clockMult[i] = atom_getfloat(argv+(i+1));
				}
			}
		}
	} else {
		//post("no valid preset command");
		if(argc > 1) {

			t_float pitches[argc];
			
			 if(strcmp(presetName, "SetQuantiseTable:") == 0) {
				//post("set %s = ",presetName);
				writeToSharedMem(x,SHM_NO_OF_TRANSPOSITIONS,argc-1);
				writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_0,0);
				writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_1,0);
				for(int i=0; i< (argc-1) / 2; ++i) {
					pitches[i*2] = atom_getfloat(argv+((i*2)+1));
					//post("%d pitch up: %f ",162+(i*2),pitches[i*2]);
					writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_2+(i*2),pitches[i*2]);
					pitches[(i*2)+1] = atom_getfloat(argv+((i*2)+2));
					//post("%d pitch up: %f, %d pitch down: %f ",162+(i*2), pitches[i*2], 162+(i*2)+1, pitches[(i*2)+1]);
					post("setting pitch deviation up %f and down: %f ",pitches[i*2], pitches[(i*2)+1]);
					writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_2+(i*2)+1,pitches[(i*2)+1]);
				}
				//post("total of %d pitches", argc-1);
			} 
			else if(strcmp(presetName, "QuantiseTable:") == 0) {
				//post("set %s = ",presetName);
				writeToSharedMem(x,SHM_NO_OF_TRANSPOSITIONS,argc-1);
				writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_0,0);
				writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_1,0);
				for(int i=0; i< (argc-1) / 2; ++i) {
					pitches[i*2] = atom_getfloat(argv+((i*2)+1));
					//post("%d pitch up: %f ",162+(i*2),pitches[i*2]);
					writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_2+(i*2),pitches[i*2]);
					pitches[(i*2)+1] = atom_getfloat(argv+((i*2)+2));
					//post("%d pitch up: %f, %d pitch down: %f ",162+(i*2), pitches[i*2], 162+(i*2)+1, pitches[(i*2)+1]);
					post("setting pitch deviation up %f and down: %f ",pitches[i*2], pitches[(i*2)+1]);
					writeFloatToSharedMem(x,SHM_DEVIATION_PITCH_2+(i*2)+1,pitches[(i*2)+1]);
				}
				//post("total of %d pitches", argc-1);
			}
		}
	}
}

t_int _checkForCalibrationFileOnBoot(t_arbhar_gpio_tilde *x)
{
	FILE *fp = fopen("/boot/calibrated","r+");
		if (fp == NULL) {
			post("no 'calibrated' confirmation on /boot");
			return 1;
		} else {
			post("'calibrated' file found");
			return 0;
		}
}


/**
 * this is the "constructor" of the class
 * the argument is the initial mixing-factor
 */
void *arbhar_gpio_tilde_new(t_floatarg memId, t_floatarg memSize)
{
  t_arbhar_gpio_tilde *x = (t_arbhar_gpio_tilde *)pd_new(arbhar_gpio_tilde_class);
  
	x->x_followLoop = 1;
	x->x_followLengthAsHold = 1;
	x->x_followPosOffsetByScanCV = 1;
	
	x->x_useHoldToSwitch = 0;
	
	x->x_enableClockedModeSwitch = ENABLE_CLOCKED_MODE_SWITCH;
	x->x_internalBpmClock = USE_BPM_CLOCK;
	x->clock_sets_length = CLOCK_SETS_LENGTH;
	
	x->x_bpm = 120;
	x->x_bpm_suggestedFromManual = -1;
	x->x_bpm_suggestedFromCV = -1;
  
  x->x_blockAllButtons = 1;
  
  x->x_modToPanning = 0;
  x->x_modToHold = 0;
  x->x_modToReverb = 1;
  x->x_modToDelay = 0;
  
  x->x_previewEnable = 0;
  
  //_checkForCalibrationFileOnBoot(x);
	_setCalibrationMode(x);
	
  post("paramModeStruct: %d",x->x_paramModeInfo.current_param_mode);
  
  x->x_lastParamPage = 255;
  
  x->x_recOnButtonUp = REC_ON_BUTTON_UP;
  x->x_captureButtonMode = CAPTURE_BUTTON_AS_GATE;
  x->x_captureCvAsGate = CAPTURE_CV_AS_GATE;
  x->x_strikeCvDelay = STRIKE_CV_DELAY;
  x->x_accumRecording = ACCUMULATE_RECORDINGS_IN_LAYER;
  x->x_linkAccumCaptureAsGate = LINK_ACCUM_CAPTURE_AS_GATE;
  x->x_followBiDirectional = FOLLOW_SPEED_BIDIRECTIONAL;
  
  x->x_strikeToTrigger = 0;
 
  
  if(x->x_captureButtonMode)
	x->x_recOnButtonUp = 0;
	
  x->x_buttons.buttonPointers[0] = &x->x_buttons.shift;
  x->x_buttons.buttonPointers[1] = &x->x_buttons.capture;
  x->x_buttons.buttonPointers[2] = &x->x_buttons.strike;

	x->lyr_rgb[0] = 0;
	x->lyr_rgb[1] = 76;
	x->lyr_rgb[2] = 111;
	x->lyr_rgb[3] = 8;
	x->lyr_rgb[4] = 18;
	x->lyr_rgb[5] = 56;
	x->lyr_rgb[6] = 90;
	x->lyr_rgb[7] = 111;
	x->lyr_rgb[8] = 25;
	x->lyr_rgb[9] = 0;
	
	x->x_onsetModes[ALPHA].name = ALPHA;
	x->x_onsetModes[ALPHA].captureCtrl = 1;
	x->x_onsetModes[ALPHA].strikeCtrl = 0;
	x->x_onsetModes[ALPHA].triggerOnset = 0;
	x->x_onsetModes[ALPHA].triggerGrain = 1;
	x->x_onsetModes[ALPHA].triggerHold = 0;
	x->x_onsetModes[ALPHA].followModeEOC = 0;
	x->x_onsetModes[ALPHA].plusLedColour = 2;
	
	x->x_onsetModes[BETA].name = BETA;
	x->x_onsetModes[BETA].captureCtrl = 1;
	x->x_onsetModes[BETA].strikeCtrl = 0;
	x->x_onsetModes[BETA].triggerOnset = 1;
	x->x_onsetModes[BETA].triggerGrain = 0;
	x->x_onsetModes[BETA].triggerHold = 1;
	x->x_onsetModes[BETA].followModeEOC = 0;
	x->x_onsetModes[BETA].plusLedColour = 2;
	
	x->x_onsetModes[GAMMA].name = GAMMA;
	x->x_onsetModes[GAMMA].captureCtrl = 0;
	x->x_onsetModes[GAMMA].strikeCtrl = 0;
	x->x_onsetModes[GAMMA].triggerOnset = 1;
	x->x_onsetModes[GAMMA].triggerGrain = 1;
	x->x_onsetModes[GAMMA].triggerHold = 0;
	x->x_onsetModes[GAMMA].followModeEOC = 0;
	x->x_onsetModes[GAMMA].plusLedColour = 1;
	
	x->x_onsetModes[DELTA].name = DELTA;
	x->x_onsetModes[DELTA].captureCtrl = 0;
	x->x_onsetModes[DELTA].strikeCtrl = 0;
	x->x_onsetModes[DELTA].triggerOnset = 1;
	x->x_onsetModes[DELTA].triggerGrain = 0;
	x->x_onsetModes[DELTA].triggerHold = 1;
	x->x_onsetModes[DELTA].followModeEOC = 0;
	x->x_onsetModes[DELTA].plusLedColour = 1;
	
	x->x_onsetModes[EPSILON].name = EPSILON;
	x->x_onsetModes[EPSILON].captureCtrl = 0;
	x->x_onsetModes[EPSILON].strikeCtrl = 1;
	x->x_onsetModes[EPSILON].triggerOnset = 1;
	x->x_onsetModes[EPSILON].triggerGrain = 0;
	x->x_onsetModes[EPSILON].triggerHold = 0;
	x->x_onsetModes[EPSILON].followModeEOC = 1;
	x->x_onsetModes[EPSILON].plusLedColour = 1;
	
	x->x_onsetModes[ZETA].name = ZETA;
	x->x_onsetModes[ZETA].captureCtrl = 0;
	x->x_onsetModes[ZETA].strikeCtrl = 0;
	x->x_onsetModes[ZETA].triggerOnset = 0;
	x->x_onsetModes[ZETA].triggerGrain = 0;
	x->x_onsetModes[ZETA].triggerHold = 0;
	x->x_onsetModes[ZETA].followModeEOC = 1;
	x->x_onsetModes[ZETA].plusLedColour = 1;

	x->x_allowOnsetModeChange = 0;

	x->x_playRecCoupled = 1;
	
	x->x_protectPlayLayerValue = 0;
  
  x->main_adc_samp_rate = ADC_SAMP_RATE;
  x->adc_samp_rate = ADC_SAMP_RATE;
  x->strike_samp_rate = STRIKE_SAMP_RATE;
  
  x->printMcpChValue = -1;

  x->x_getFromGpio = clock_new(x, (t_method)tick_getBCM2835);
  x->x_getStrike = clock_new(x, (t_method)_getStrikeCvToShMem);
  x->x_setOnGpio = clock_new(x, (t_method)tick_setBCM2835);
  x->x_playPosLedOff = clock_new(x, (t_method)led_PlayPosOff);
  x->x_layerLedControl = clock_new(x, (t_method)tick_layerLedControl);
  x->x_strikeLed = clock_new(x, (t_method)tick_strikeLed);
  x->x_strikeCvLed = clock_new(x, (t_method)tick_strikeCvLed);
  x->x_strikeTrigger = clock_new(x, (t_method)tick_strikeTrigger);
  x->x_captureCvLed = clock_new(x, (t_method)tick_captureCvLed);
  x->x_buttonDown = clock_new(x, (t_method)tick_processButtonDown);
  x->x_buttonUp = clock_new(x, (t_method)tick_processButtonUp);
  x->x_scheduleRecordingStart = clock_new(x, (t_method)tick_scheduleRecordingStart);
  x->x_clockTriggeringGrains = clock_new(x, (t_method)tick_clockedGrains);
  x->x_bpmClock = clock_new(x,(t_method)tick_bpmClock);

  x->x_followMode = 0;
  x->x_followSpeed = 1;
  x->x_followPosition = 0;

  clock_set(x->x_layerLedControl,1000);
  /* create a new signal-outlet */
  x->x_out = outlet_new(&x->x_obj, &s_signal);
 /* 
  	0 VPO = 2, //V/Oct
	1 LYC = 4, //Layer CV
	2 SCC = 7, //Scan CV
	3 TEX = 14, //texture
	4 DIR = 10, //Direction
	5 LEN = 1, //Length
	6 MOD = 13, // Mod
	7 SCP = 0, // Scan Pot
	8 DW = 6, // Dry/Wet
	9 PI = 3, //Pitch
	10 INT = 12, //Intensity
	11 LYP = 5, //Layer Pot
	12 SPR = 9, //Spray
	13 HOL = 8, //Hold
	14 DUB = 11, //Overdub
	15 DEV = 15 //Deviation
	*/
	
  for(int i=0;i<16;i++){
	 x->x_ch[i].raw = 0;
	 x->x_ch[i].val = 0;
	 x->x_ch[i].last = 0;
	 x->x_ch[i].highest = POT_HIGHEST;
	 x->x_ch[i].lowest = POT_LOWEST;
	 setBufCountMax(&x->x_ch[i],15);
	 setNotch(&x->x_ch[i], 40);
	 setFreezeThresh(&x->x_ch[i],2);
	 setFreezeCountMax(&x->x_ch[i],2500);
 }
 
  x->x_ch[0].name = gensym("vpo"); x->x_ch[0].ch = _VPO; 
  setMid(&x->x_ch[0],2063); // x->x_ch[0].mid = 2063;
  setNotch(&x->x_ch[0],0);
  setBufCountMax(&x->x_ch[0],2);
  setFreezeThresh(&x->x_ch[0],2);
  setFreezeCountMax(&x->x_ch[0],5);
  x->x_ch[1].name = gensym("lyc"); x->x_ch[1].ch = _LYC; 
  setMid(&x->x_ch[1],2055);
  setNotch(&x->x_ch[1],0);
  setFreezeCountMax(&x->x_ch[1],250);
  x->x_ch[2].name = gensym("scc"); x->x_ch[2].ch = _SCC;// x->x_ch[2].mid = 2077;
  setMid(&x->x_ch[2],2061);
  setNotch(&x->x_ch[2],0);
  setFreezeCountMax(&x->x_ch[2],2500);
  setFreezeThresh(&x->x_ch[2],7);
  x->x_ch[3].name = gensym("tex"); x->x_ch[3].ch = _TEX; //x->x_ch[3].mid = 1577;
  setMid(&x->x_ch[3],1577);
  setNotch(&x->x_ch[3],100);
  setFreezeCountMax(&x->x_ch[3],250);
  x->x_ch[4].name = gensym("dir"); x->x_ch[4].ch = _DIR; //x->x_ch[4].mid = 1668;
  setMid(&x->x_ch[4],1668);
  setFreezeCountMax(&x->x_ch[4],250);
  x->x_ch[5].name = gensym("len"); x->x_ch[5].ch = _LEN; //x->x_ch[5].mid = 1705;
  setMid(&x->x_ch[5],1705);
  setFreezeCountMax(&x->x_ch[5],250);
  setNotch(&x->x_ch[5],0);
  x->x_ch[6].name = gensym("mod"); x->x_ch[6].ch = _MOD; //x->x_ch[6].mid = 2077;
  setMid(&x->x_ch[6],2077);
  x->x_ch[7].name = gensym("scp"); x->x_ch[7].ch = _SCP; 
  setMid(&x->x_ch[7],1611);
  setNotch(&x->x_ch[7],0);
  setBufCountMax(&x->x_ch[7],15); //25  //45
  setFreezeThresh(&x->x_ch[7],15); //33  //15
  setFreezeCountMax(&x->x_ch[7],50); //50   //25
  x->x_ch[8].name = gensym("dw"); x->x_ch[8].ch = _DW; //x->x_ch[8].mid = 1686;
  setMid(&x->x_ch[8],1686);
  x->x_ch[8].highest = 4070;
  x->x_ch[8].lowest = 30;
  x->x_ch[9].name = gensym("pi"); x->x_ch[9].ch = _PI; //x->x_ch[9].mid = 1667;
  setMid(&x->x_ch[9],1667);
  setNotch(&x->x_ch[9], 160);
  x->x_ch[10].name = gensym("int"); x->x_ch[10].ch = _INT; //x->x_ch[10].mid = 1631;
  setMid(&x->x_ch[10],1631);
  x->x_ch[11].name = gensym("lyp"); x->x_ch[11].ch = _LYP; //x->x_ch[11].mid = 1746;
  setMid(&x->x_ch[11],1746);
  setBufCountMax(&x->x_ch[11],25);  //50
  setFreezeThresh(&x->x_ch[11],33); //33
  setFreezeCountMax(&x->x_ch[11],250); //50
  x->x_ch[12].name = gensym("spr"); x->x_ch[12].ch = _SPR; //x->x_ch[12].mid = 1694;
  setMid(&x->x_ch[12],1694);
  x->x_ch[13].name = gensym("hol"); x->x_ch[13].ch = _HOL; //x->x_ch[13].mid = 1673;
  setMid(&x->x_ch[13],1673);
  setNotch(&x->x_ch[13],0);
  x->x_ch[14].name = gensym("dub"); x->x_ch[14].ch = _DUB; //x->x_ch[14].mid = 1632;
  setMid(&x->x_ch[14],1632);
  setNotch(&x->x_ch[14],0);
  x->x_ch[15].name = gensym("dev"); x->x_ch[15].ch = _DEV; //x->x_ch[15].mid = 1602;
  setMid(&x->x_ch[15],1602);

  for (int i=0;i<16;i++){
	post("mch_ch no and order: %d -> %d",x->x_ch[i].ch, i);
  }

	x->x_currentOnsetMode = &x->x_onsetModes[DEFAULT_ONSET_MODE];
	post("x->x_currentOnsetMode.name = %d", x->x_currentOnsetMode->name);
  
  x->share_memory = NULL;

  x->g_info_out = outlet_new(&x->x_obj, gensym("list"));
  x->layerBufOp = outlet_new(&x->x_obj, gensym("list"));
  x->toSerial = outlet_new(&x->x_obj, gensym("list"));
  x->eeprom_out = outlet_new(&x->x_obj, gensym("list"));
  x->config_out = outlet_new(&x->x_obj, gensym("list"));
  x->calibrated_out = outlet_new(&x->x_obj, gensym("list"));
  _shmem_allocate(x, memId, memSize);
  
  x->whiteLayerValue=0;
  x->orangeLayerValue=0;
 
   //set phase switch:
  writeToSharedMem(x,SHM_PHASE_SHIFT,OUTPUT_PHASE_SWITCH);
  
	//_setStereoSwitch(x, ENABLE_STEREO);
	writeToSharedMem(x,SHM_STEREO_INPUT,ENABLE_STEREO);
	x->x_stereo = ENABLE_STEREO;
	
	_setModCvProcessesToMidValues(x,2048);
	
	writeToSharedMem(x,SHM_USING_QUENTISED_PITCH,0);

	checkInternalClock(x);

	t_float clockMultDefault[11] = {1, 1.5, 2, 3, 4, 6, 8, 12, 16, 24, 32};
	t_float clockDivDefault[5] = {1, 1.5, 2, 3, 4};
	x->clockMultLength = 11;
	x->clockDivLength = 5;
	x->x_inputClockDivision = INPUT_CLOCK_DIVISION;
	for(int i=0; i < x->clockMultLength; i++){
		x->clockMult[i] = clockMultDefault[i];
	}
	for(int i=0; i < x->clockDivLength; i++){
		x->clockDiv[i] = clockDivDefault[i];
	}
  
  return (void *)x;
}

void _setup_gpio(t_arbhar_gpio_tilde *x)
{
	x->x_dspSynced = 0;
	
	
	if(bcm2835_init()){
		post("gpio setup: %d",bcm2835_version());
		//bcm2835_spi_begin();
		//bcm2835_spi_setClockDivider(BCM2835_SPI_CLOCK_DIVIDER_128);
		uint8_t shiftB = !bcm2835_gpio_lev(SHIFT);
		uint8_t captureB = !bcm2835_gpio_lev(CAPTURE_BUTTON);
		uint8_t strikeB = !bcm2835_gpio_lev(STRIKE_BUTTON);
		uint8_t calibrationMode = shiftB * captureB * strikeB;

		//post("calibration mode: %d ", calibrationMode);

		if(calibrationMode){
			x->x_arbharMode = CALIBRATION_MODE;
			t_atom ctlInfo[2];
			SETFLOAT(ctlInfo, 255);
			SETFLOAT(ctlInfo+1, 255);
			outlet_list(x->eeprom_out, gensym("list"),2,ctlInfo);
		}	else 
		{
			x->x_arbharMode = GRANULAR_MODE;
			t_atom ctlInfo[1];
			SETFLOAT(ctlInfo, 254);
		//	if(x->x_arbharMode < CALIBRATION_MODE)
			outlet_list(x->eeprom_out, gensym("list"),1,ctlInfo);
		}
		post("calibration mode (enum): %d ", x->x_arbharMode);
	}
	else
		post("bcm error");
		

    
    bcm2835_gpio_fsel(CAPTURE_BUTTON, BCM2835_GPIO_FSEL_INPT);
	bcm2835_gpio_fsel(CAPTURE_CV, BCM2835_GPIO_FSEL_INPT);
	bcm2835_gpio_fsel(STRIKE_BUTTON, BCM2835_GPIO_FSEL_INPT);
	bcm2835_gpio_fsel(STRIKE_CV, BCM2835_GPIO_FSEL_INPT);
	bcm2835_gpio_fsel(SHIFT, BCM2835_GPIO_FSEL_INPT);
	bcm2835_gpio_fsel(SWITCH_AB, BCM2835_GPIO_FSEL_INPT);
	bcm2835_gpio_fsel(SWITCH_XY, BCM2835_GPIO_FSEL_INPT);
	
	bcm2835_gpio_set_pud(CAPTURE_BUTTON, BCM2835_GPIO_PUD_UP);
	bcm2835_gpio_set_pud(CAPTURE_CV, BCM2835_GPIO_PUD_UP);
	bcm2835_gpio_set_pud(STRIKE_BUTTON, BCM2835_GPIO_PUD_UP);
	bcm2835_gpio_set_pud(STRIKE_CV, BCM2835_GPIO_PUD_UP);
	bcm2835_gpio_set_pud(SHIFT, BCM2835_GPIO_PUD_UP);
	bcm2835_gpio_set_pud(SWITCH_AB, BCM2835_GPIO_PUD_UP);
	bcm2835_gpio_set_pud(SWITCH_XY, BCM2835_GPIO_PUD_UP);

    bcm2835_gpio_fsel(FWD_W, BCM2835_GPIO_FSEL_OUTP);
    bcm2835_gpio_fsel(FWD_Y, BCM2835_GPIO_FSEL_OUTP);
    bcm2835_gpio_fsel(REV_W, BCM2835_GPIO_FSEL_OUTP);
    bcm2835_gpio_fsel(REV_Y, BCM2835_GPIO_FSEL_OUTP);
    bcm2835_gpio_fsel(PLUS_W, BCM2835_GPIO_FSEL_OUTP);
    bcm2835_gpio_fsel(PLUS_Y, BCM2835_GPIO_FSEL_OUTP);
    bcm2835_gpio_fsel(TRIGGER_OUT, BCM2835_GPIO_FSEL_OUTP);


}


/**
 * define the function-space of the class
 * within a single-object external the name of this function is very special
 */
void arbhar_gpio_tilde_setup(void) {
  arbhar_gpio_tilde_class = class_new(gensym("arbhar_gpio~"),
        (t_newmethod)arbhar_gpio_tilde_new,
        (t_method)arbhar_gpio_tilde_free,
	sizeof(t_arbhar_gpio_tilde),
        CLASS_DEFAULT,
        A_DEFFLOAT, A_DEFFLOAT, 0);

  class_addmethod(arbhar_gpio_tilde_class,
        (t_method)arbhar_gpio_tilde_dsp, gensym("dsp"), 0);
  class_addbang(arbhar_gpio_tilde_class, arbhar_gpio_tilde_bang);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setCurrentParamMode,
	 gensym("setParamMode"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setTriggerOut,
	 gensym("setTrigger"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setFwdLed,
	 gensym("setFwdLed"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setRevLed,
	 gensym("setRevLed"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setPlusLed,
	 gensym("setPlusLed"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setDspSynced,
	 gensym("dspSynced"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setAdcSampRate,
	 gensym("setAdcSampRate"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)_setStrikeSampRate,
	 gensym("setStrikeSampRate"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)led_menuPagesIndicator,
	 gensym("testMenu"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class,  (t_method)printMcpChValues,
	 gensym("printMcpChValues"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setup_gpio, gensym("setup_gpio"), 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setMidValue,
             gensym("setMid"), A_GIMME, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_learnMid,
             gensym("learnMid"), 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setFreezeThresh,
             gensym("setFreezeThresh"), A_FLOAT, A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setFreezeCount,
             gensym("setFreezeCount"), A_FLOAT, A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setWhiteLayerLeds,
             gensym("setWhiteLeds"), A_FLOAT, A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_takeCalibrationValues,
             gensym("takeCalibrationValues"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setVpo3VoltValue,
             gensym("setVpo3VoltValue"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setCalibrationMode,
             gensym("setCalibrationMode"), 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setMidValueByCh,
             gensym("setMidValueByCh"), A_GIMME, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setFollowMode,
             gensym("setFollowMode"), A_FLOAT, 0);
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setPresetValues,
             gensym("setPresetValues"), A_GIMME, 0);  
  class_addmethod(arbhar_gpio_tilde_class, (t_method)_setModCVMode,
             gensym("setModCvMode"), A_FLOAT, 0);        

  CLASS_MAINSIGNALIN(arbhar_gpio_tilde_class, t_arbhar_gpio_tilde, f);
}
