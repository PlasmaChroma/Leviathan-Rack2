static void setQuantisedPitch(t_arbhar_play_tilde *x, t_float v)
{
  x->x_qPitch = v >= 0 ? (v<= 12 ? v : 12) : 0;
  int pDev = (int)x->x_qPitch;
  x->x_qPitchVals[0] = 1.0f;
  // post("pitchDeviation index: %d", pDev);
  x->x_qPitchVals[1] = PITCH_VALUES[(int)(69 + Q_PITCH_DEVIATION[pDev * 2])];
  x->x_qPitchVals[2] = PITCH_VALUES[(int)(69 + Q_PITCH_DEVIATION[(pDev * 2)+1])];
  // post("pitchDeviation: %f %f %f", x->x_qPitchVals[0], x->x_qPitchVals[1], x->x_qPitchVals[2]);
}

static t_float calcQuantisedPitch(t_arbhar_play_tilde *x)
{
  t_float up = 15;
  t_float dwn = 45;
  t_float random = fmod(rand(),100);
  t_float retVal = 1.0f;
  if(random <= up){
    retVal = x->x_qPitchVals[1];
  } else if(random > up && random <= up + dwn ){
    retVal = x->x_qPitchVals[2];
  } else {
    retVal = x->x_qPitchVals[0];
  }
  return retVal;
}

static void setRandomPitch(t_arbhar_play_tilde *x, t_float v)
{
  x->x_rPitch = v;
}

static void setDeviation(t_arbhar_play_tilde *x, t_float v)
{
  if(v >= 0) {
    setQuantisedPitch(x,v*12);
    setRandomPitch(x,0);
  } else {
    setQuantisedPitch(x,0);
    setRandomPitch(x,v * -1);
  }
}

