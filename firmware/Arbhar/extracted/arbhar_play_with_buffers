void arbhar_play_tilde_allocate(t_arbhar_play_tilde *x, t_int section, t_float fId, t_float fSize)
{
  int id = (int) fId;
  if ( id < 1 ){
    error("id should be > 0"); // shmid 0 doesn't seem to work
    return;
  }

  x->segment_size[section] = (int) fSize;
  int size = sizeof(t_float)*x->segment_size[section];

  struct shmid_ds shmbuffer;
  if (x->share_memory[section]) {
    shmdt (x->share_memory[section]);
    x->share_memory[section]=NULL;
  }
  if (x->segment_id[section] != -1) {
    shmctl (x->segment_id[section], IPC_RMID, 0);
    x->segment_id[section] = -1;
  }

  x->segment_id[section]  =  shmget  (id,  sizeof(t_float)*x->segment_size[section],
        IPC_CREAT | S_IRUSR | S_IWUSR | S_IROTH | S_IWOTH); // AV it should safer to use ftok() to generate an id

  if(x->segment_id[section] != -1) { // 0 could be a valid value, -1 means error
    x->share_memory[section] = (t_float*) shmat (x->segment_id[section], 0, 0);
    // post("shmem memory attached at address %p\n", x->share_memory);

    shmctl (x->segment_id[section], IPC_STAT, &shmbuffer);
    // post ("segment size: %d\n", shmbuffer.shm_segsz);

    if ((int)shmbuffer.shm_segsz < (int)sizeof(t_float)*x->segment_size[section]) {
      // there was a problem, set object meme size to 0
      error("could not allocate shmem memory Id : %d, size %d", (int)id,  x->segment_size[section] );
      x->segment_size[section] = 0;
      x->share_memory[section]=NULL;
      //outlet_float(x->m_info_out, -1);
    }
  }
  else {
    error("could not allocate shmem memory Id : %d, size %d", (int)id,  x->segment_size[section] );
    x->segment_size[section] = 0;
    //outlet_float(x->m_info_out, -1);
  }
    //outlet_float(x->m_info_out, id);
}

t_float _memread(t_arbhar_play_tilde *x, t_float s, t_float index)
{
  t_int section = (t_int)s;
    if ( !x->share_memory[section] ) return -1;
    int shmem_offset;

	shmem_offset = index;
	if (shmem_offset < 0) shmem_offset = 0;
	if (shmem_offset > x->segment_size[section]-1) shmem_offset = x->segment_size[section]-1;
	// post("i=%d", offset);
	//outlet_float(x->x_obj.ob_outlet, x->share_memory[shmem_offset]);
	t_float readval = x->share_memory[section][shmem_offset];

	return readval;
}

void writeToSharedMem(t_arbhar_play_tilde *x, t_float s, t_float n, t_float val)
{
  t_int section = (t_int)s;
    if ( !x->share_memory[section] ){
        error("Create a valid shared memory before setting data !");
        return;
    }

    int i=0, j, index_max, shmem_offset, array_offset, size;

	shmem_offset = (int)n;
	if (shmem_offset < 0) shmem_offset=0;

	index_max = x->segment_size[section] - shmem_offset;
	//post("this is checking memwrite: %f, %f offset %d, size %d", n, val, shmem_offset, x->segment_size[section]);
	x->share_memory[section][i+shmem_offset]=val;

  
}

