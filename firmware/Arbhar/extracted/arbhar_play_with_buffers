static int dirExists(t_arbhar_play_tilde *x, const char* path)
{
	DIR *dir= opendir(path);
	if (dir)
	{
		closedir(dir);
		return 1;
	}
	else if (errno == ENOENT)
	{
		if (DEVMODE) pd_error(x,"path not found");
		return 0;
	}
	else
	{
		if (DEVMODE) pd_error(x,"accessing path error %d",errno);
		return 0;
	}
}



