t_grain *_getPositionRange(t_arbhar_play_tilde *x,t_grain *g)
{	//get storedvalues from shmem
	//post("pitch %f", _calcPitch(_memread(x, 0, 2), _memread(x, 0, 3)));
	//t_grain createGrain;
	t_float bufAccessSize = 10000;
	t_float sr = 48;
	t_float mcpChSCP = 4095 - _memread(x, 0, 0);
  //post("reading mcpChSCP %f", _memread(x, 0));
	t_float mcpChSCC = 4095 - _memread(x, 0, 7) - 2048;
	t_float mcpChSPR = 4095 - _memread(x, 0, 9);
	//t_float mcpChLEN = 4095 - _memread(x, 0, 1);
	static t_float deviation = 0;
	t_float mcpChDEV = ((4095 - _memread(x, 0, 15)) * 0.04884 ) - 100;
	t_float qrPitch = (t_int)(mcpChDEV+0.5) * 0.01; 
	//post("reading mcpChDEV %f", mcpChDEV);
	setDeviation(x, qrPitch);
	t_float mcpChDIR = _memread(x, 0, 10);
	t_float SCPSCC = mcpChSCP + mcpChSCC;
	SCPSCC = SCPSCC >= 4095 ? 4095 : SCPSCC < 0 ? 0 : SCPSCC;
	t_float position = sr * SCPSCC * 2.442002442; // 10000 / 4095
	//t_float spray = sr * mcpChSPR * 2.442002442;
	t_float spray = pow(mcpChSPR/4095,3) * 480000;
	spray = spray > 480000 ? 480000 : spray;
	//post("spray %f", spray);
	//t_float length = /*sr * */ mcpChLEN / 4095; //* 0.732600732; // 3000 / 4095
	//length = length * length * 3000 * sr;
	////post("length %f", length);
	//length = length > 3000*sr ? 3000*sr : length;
	t_float direction = mcpChDIR * 0.02442003; //100 / 4095
	if(position+spray > sr * bufAccessSize)
	{
		t_float posCorrect = position+spray - (sr * bufAccessSize);
		position = position - posCorrect;
	}
	t_float start = position;
	t_float sprayVal = calcSprayFloat(spray);
	g->g_startPos = (t_int)(start + sprayVal);
	g->g_duration = (t_int)_calcGrainLength(x);
	g->g_direction = (t_int)(random()%100 < direction ? 1 : -1);
	return g;
}


static void arbhar_play_tilde_next(t_arbhar_play_tilde *x)
{
	//t_grain *grain = _getPositionRange(x, &x->x_grain[12]);
	//post("* start: %d, length: %d, direction %d", grain->g_startPos, grain->g_duration, grain->g_direction);

  int noOfNotes = 0;
  // post("check polyphony: %d", x->x_polyphony);
  if(x->x_polyphony > 0){
    noOfNotes = _getChord(x) - 1;
    noOfNotes = noOfNotes < 0 ? 0 : noOfNotes;
    // post("getChord: %d", noOfNotes);
  }
  static int g = -1;
  int k = 0;
  for(int i=0;i<=noOfNotes;i++)
  {
    // post("startGrain");
    int check = 0;
    int add4St = x->x_playStereo > 0 ? 15 : 0;
    g++;
    g = g < NO_OF_GRAINS ? g : 0;
    k = g + x->x_killOffset + add4St;
    k = (int)fmod(k, NO_OF_GRAINS);
    //post("play: %d - kill: %d", g, k);
    x->x_grain[g].g_play = 1;
    x->x_grain[g].g_cPosGrain = 0;
    t_grain *grain = _getPositionRange(x, &x->x_grain[g]);
    _setGrain(x, &x->x_grain[g], 1.0f);
    arbhar_play_tilde_kill(x, k);
    check++;
  }
  x->x_lastGrainNo = g;
}

