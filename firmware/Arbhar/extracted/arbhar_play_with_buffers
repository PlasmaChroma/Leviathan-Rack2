{
  float rVol = ((float)(rand() % 1000) * 0.001) * x->x_randVolume;
  grain->g_volume = 1.0f - rVol;
  // post("rand vol %f : %f", rVol, x->x_grain[g].g_volume);
  // post("poly: %d", x->x_polyphony);
  if (grain->g_volume > 0.3){
    int layer = x->x_playLayer;
    grain->g_playLayer = layer;
    int spray = calcSpray(x->x_spray);
    float pan = (float)(rand() % 2);
    float panMod = 0;
    if (x->x_panning < 0)
      panMod = (float)((rand() % 100) * 0.01f) * x->x_panning * -0.5; /// has to be made negative!!
    else
      panMod = x->x_panning * 0.5;
    if(pan > 0.5)
      pan -= panMod;
    else
      pan += panMod;
    // post("pan: %f", pan);
    grain->g_panning = pan;
    grain->g_killVol = 1.0f;

    if(forcePitch == 1)
      grain->g_grainSpeed = _calcGrainSpeedNew(x);
    else
      grain->g_grainSpeed = forcePitch;

    grain->g_wndShape = _getTexture(x); //x->x_wndShape;

    int direction = getRandomDirection(_getDirection(x));
    grain->g_direction = direction;
    // post("grain direction: %d", direction);
 
    if(x->x_adjustDuration > 0){
      //int adjustedDuration = (int)((float)grain->g_duration * grain->g_grainSpeed);
      //grain->g_duration = adjustedDuration;
      grain->g_duration *= grain->g_grainSpeed;
    } /*else {
      grain->g_duration = x->x_duration;
    }*/
      grain->g_recDiffSpeed = 1.0f + grain->g_grainSpeed;
    //int startPos = 0;
    //if (x->x_followMode > 0)
      //startPos = x->x_followPosition + spray;
    //else
      //startPos = x->x_startPos + spray;
    //if(startPos > x->x_displayLength[layer])
      //startPos = x->x_startPos - (startPos - x->x_displayLength[layer]);
    //if (startPos + x->x_duration >= x->x_bufSize[layer])
      //startPos = startPos - ((startPos + x->x_duration) - x->x_bufSize[layer]) - spray;
    //startPos = startPos < 1 ? 1 : startPos;
    /*
    if(startPos + grain->g_duration >= x->x_bufSize[layer])
      grain->g_duration = x->x_bufSize[layer] - startPos;
      */
      
     //post("next grain duration %f", (float)grain->g_duration / 48000.f);
    
    grain->g_coef = grain->g_grainSpeed + 0.1;
    grain->g_coef = grain->g_coef > 1 ? 1 : grain->g_coef ;//0.76;
    grain->g_last[0] = 0.;
    grain->g_last[1] = 0.;
      
    switch(direction){
      case -1:{
        grain->g_cPosGrain = grain->g_duration;
        grain->g_cPosWnd = WND_LENGTH;
       // grain->g_startPos = startPos;
        break;
      }
      default:{
        grain->g_cPosGrain = 0;
        grain->g_cPosWnd = 0;
       // grain->g_startPos = startPos;
        break;
      }
    }
    
    grain->g_trigOutVal = 1;
    grain->g_trigOutTimer = 8;

    if(x->x_randIntensity > 0){
      grain->g_startDelay = rand() % grain->g_duration;
      grain->g_delayed = 1;
    }
    else
    {
      arbhar_play_tilde_tickInfoOut(x, grain);
    }
  }
}

