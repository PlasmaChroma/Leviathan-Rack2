static float _calcGrainSpeed(t_arbhar_play_tilde *x){
  float qPitch = 1.0f;
  float rPitch = 1.0f;
  if(x->x_qPitch > 0)
    qPitch = calcQuantisedPitch(x);
  if(x->x_rPitch > 0)
    rPitch = calcRandomPitch(x->x_rPitch);
  int chordPitches = _getChord(x);
  float chordPitch = 1.0f;
  if(x->x_polyphony > 0 && chordPitches > 0){
    static int getChordPitch = 0;
    if(x->x_pitchOrder > 0){
      getChordPitch++;
      getChordPitch = getChordPitch >= chordPitches ? 0 : getChordPitch;
    } else {
      getChordPitch = rand() % chordPitches;
    }
    chordPitch = _pitchToSpeed((float)x->x_polyPitches[getChordPitch]);
  }
  return x->x_speed * qPitch * rPitch * chordPitch;
}

static t_float _calcPitch(t_float vpo, t_float pitch)
{
	//vpo 1V 1633, 2V 1230, 3V = 816
	t_float vpoNorm = ((2048 - vpo) / ((2048 - 816) / 3)) * 1;
	t_float pitchNorm = (((2048 - pitch) / 2048) * 3);// + 36;
	t_float rVal = pow(2, (vpoNorm + pitchNorm));
	//t_float speed = pow(2, (rVal / 12));
	
	return rVal;
}

t_float _calcGrainLength(t_arbhar_play_tilde *x)
{
	t_float sr = 48;
	t_float mcpChLEN = 4095 - _memread(x, 0, 1);
	t_float length = /*sr * */ mcpChLEN / 4095; //* 0.732600732; // 3000 / 4095
	length = (length * length) * 3000 * sr;
	length = length > 3000*sr ? 3000*sr : length;
	return length;
}

