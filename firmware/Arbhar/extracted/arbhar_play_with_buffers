  // post("midiNote: %d : %d", (int)p, (int)v);
}

static void arbhar_play_tilde_tickInternTrig(t_arbhar_play_tilde *x){
	t_float mcpChLEN = 4095 - _memread(x, 0, 1);
	t_float duration = _calcGrainLength(x);//48 * mcpChLEN * 0.732600732; // 3000 / 4095
	t_int intensity = (t_int)_getIntensity(x);
	static t_int pIntensity = 0;
	if(pIntensity != intensity){
		post("intensity %d", intensity);
		pIntensity = intensity;
	}
	
  if(duration > 0 && x->x_internTrigActive > 0){
    if(intensity > 0)
    {
    t_int triggerAt = ((duration / intensity)/ x->x_sampleRate * 10000.0f);// / x->x_speed;
      if(x->x_internTrigCount >= triggerAt  && x->x_grainsActive <= NO_OF_GRAINS - KILLOFFSET) {
        arbhar_play_tilde_next(x);
        outlet_float(x->x_voicesInfo, 1.0f);
        x->x_internTrigCount = 0;
      }
    x->x_internTrigCount++;
    clock_delay(x->x_internTrig, 0.1f);
    }
  }
}

/**
 * register a special perform-routine at the dsp-engine
 * this function gets called whenever the DSP is turned ON
 * the name of this function is registered in pan_tilde_setup()
 */
void arbhar_play_tilde_dsp(t_arbhar_play_tilde *x, t_signal **sp)
{
  /* add pan_tilde_perform() to the DSP-tree;
   * the pan_tilde_perform() will expect "5" arguments (packed into an
   * t_int-array), which are:
   * the objects data-space, 3 signal vectors (which happen to be
   * 2 input signals and 1 output signal) and the length of the
   * signal vectors (all vectors are of the same length)
   */

  // arbhar_play_tilde_set_layer(x, x->x_buffer[0], 0);
  // arbhar_play_tilde_set_layer(x, x->x_buffer[1], 1);
  // arbhar_play_tilde_set_layer(x, x->x_buffer[2], 2);
  // arbhar_play_tilde_set_layer(x, x->x_buffer[3], 3);
  // arbhar_play_tilde_set_layer(x, x->x_buffer[4], 4);
  // arbhar_play_tilde_set_layer(x, x->x_buffer[5], 5);
  // arbhar_play_tilde_set_w(x, x->x_window);

  post("arbhar_play~ buffers");
  int noStBuf = x->x_noOfBufUsed/2;
   for(int i=0;i<noStBuf;i++){
     arbhar_play_tilde_set_layer(x, x->x_buffer[i], i);
     arbhar_play_tilde_set_layer(x, x->x_buffer[i+noStBuf], i+noStBuf);
     post("name: %s, length: %d",x->x_buffer[i]->s_name, x->x_bufSize[i]);
     post("name: %s, length: %d",x->x_buffer[i+noStBuf]->s_name, x->x_bufSize[i+noStBuf]);
   }

  dsp_add(arbhar_play_tilde_perform, 4, x,
          sp[0]->s_vec, sp[1]->s_vec, sp[0]->s_n);

  x->x_sampleRate = sp[0]->s_sr;

 post("arbhar_play~ samplerate: %f):", x->x_sampleRate);
  // post("arbhar_play~ wnd size: %d):", x->x_wndSize);

  clock_set(x->x_internTrig, 0.0f);
}

/**
 * this is the "destructor" of the class;
 * it allows us to free dynamically allocated ressources
 */
void arbhar_play_tilde_free(t_arbhar_play_tilde *x)
{
  /* free any ressources associated with the given inlet */
  // inlet_free(x->x_recPosIn);
  // inlet_free(x->x_in3);
  t_int section = 0;
    if ( x->share_memory[section] ){
    if ( shmdt (x->share_memory[section]) == -1) error("shmdt failed at %x", x->share_memory[section]);
  }
  x->share_memory[section]=NULL;

  int shm_id = x->segment_id[section];
  struct shmid_ds shm_desc;
  if(shm_id>0){
    if (shmctl(shm_id,IPC_STAT, &shm_desc) != -1){
      if(shm_desc.shm_nattch<=0){
        if (shmctl(shm_id,IPC_RMID, &shm_desc) == -1) error("shmctl remove failed for %d", shm_id);
      }
    }
  }
  shm_id=0;

  /* free any ressources associated with the given outlet */
  outlet_free(x->x_out_L);
  outlet_free(x->x_out_R);
  outlet_free(x->x_info);
  outlet_free(x->x_infoStart);
  outlet_free(x->x_trigger);
  outlet_free(x->x_followInfo);
  outlet_free(x->x_voicesInfo);
}

