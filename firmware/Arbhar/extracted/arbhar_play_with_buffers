static t_int _getChord(t_arbhar_play_tilde *x){
  int no = 0;
  t_float val = 0;
  float arrangedPitches[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  for (int i=0; i<8;i++) {
    if(x->x_polyPitches[i] > 0){
      arrangedPitches[no] = x->x_polyPitches[i];
      no++;
    }
  }
  for (int p=0; p<8;p++) {
    x->x_polyPitches[p] = arrangedPitches[p];
  }
  x->x_polyphony = no > 0 ? 1 : 0;
  // post("polyphony: %d", no);
  return no;
}

