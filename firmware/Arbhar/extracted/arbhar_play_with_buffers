#define COMBINE_STEREO_GRAINS() if(x->x_grain[g].g_coef < 1) { \
								t_sample fb = 1 - x->x_grain[g].g_coef; \
								intpSampVal = x->x_grain[g].g_coef * intpSampVal + fb * x->x_grain[g].g_last[0]; \
								intpSampVal2 = x->x_grain[g].g_coef * intpSampVal2 + fb * x->x_grain[g].g_last[1]; \
								x->x_grain[g].g_last[0] = intpSampVal; \
								x->x_grain[g].g_last[1] = intpSampVal2; \
								} \
								tempVol = intpSampVal * wndVal; \
                                tempVol2 = intpSampVal2 * wndVal; \
                                tempVol *= volAdjustment * killVol; \
                                tempVol2 *= volAdjustment * killVol; \
                                tempR = tempVol * x->x_grain[g].g_panning; \
                                tempR += tempVol2 * (1 - x->x_grain[g].g_panning); \
                                tempL = tempVol2 * x->x_grain[g].g_panning; \
                                tempL += tempVol * (1 - x->x_grain[g].g_panning);


////////////////////////arbhar_play_tilde_perform//////////////////////////////////////
t_int *arbhar_play_tilde_perform(t_int *w)
{
  /* the first element is a pointer to the dataspace of this object */
  t_arbhar_play_tilde *x = (t_arbhar_play_tilde *)(w[1]);
  /* here is a pointer to the t_sample arrays that hold the 2 input signals */
  // t_sample  *in1 =    (t_sample *)(w[2]);
  // t_sample  *recHead =    (t_sample *)(w[3]);
  t_sample *out1 = (t_sample *)(w[2]);
  t_sample *out2 = (t_sample *)(w[3]);
  int n = (int)(w[4]);
  int maxIdBuf, i, g;
  t_word *buf = x->x_bufPntr[0];
  t_word *wp;
  t_word *buf2 = x->x_bufPntr[0];
  t_word *wp2;

  if (x->x_recordingState > 0)
    x->x_recordingPos += n;
  else
    x->x_recordingPos = 0x7fffffff;

  maxIdBuf = x->x_bufSize[0] - 3; /// -3 because of interpolation, otherwise -1 would be correct

  if(maxIdBuf<0) goto zero;
  if(!buf) goto zero;

  if (x->x_duration > maxIdBuf)
    x->x_duration = maxIdBuf;

   x->x_inVal = 0;

   for(i=0; i<n; i++)
   {
     out1[i] = 0;
     out2[i] = 0;
   }

   t_float fPos = x->x_followPosition;
   if (x->x_followMode > 0){
     fPos += n * x->x_followSpeed;
     if(fPos >= (float)x->x_displayLength[0])
      fPos = 0;
     else if (fPos < 0)
      fPos = (float)x->x_displayLength[0];
     x->x_followPosition = fPos;
     arbhar_play_tilde_tickFollow(x);
   }

   static int pActiveGrains = 0;
   int activeGrains = checkForActiveGrains(x);
   if (pActiveGrains != activeGrains){
    clock_set(x->x_clockActiveGrains, 0.f);
    }
   pActiveGrains = activeGrains;

   int noStBuf = x->x_noOfBufUsed/2;

   t_float volRedFactor = calcVolReduction(activeGrains);
   for ( g=0; g<NO_OF_GRAINS; g++)
   {
     if(x->x_grain[g].g_startDelay > 0){
       x->x_grain[g].g_startDelay -= n;
     } else {
       if(x->x_grain[g].g_delayed > 0){
         x->x_triggerVal = 1 - x->x_triggerVal;
         x->x_grain[g].g_delayed = 0;
         arbhar_play_tilde_tickInfoOut(x, &x->x_grain[g]);
       }
       if (x->x_grain[g].g_kill > 0)
          _adjustKillFade(&x->x_grain[g]);
       if (x->x_grain[g].g_trigOutVal > 0)
         _setTiggerOutValue(x, g);
       int play = x->x_grain[g].g_play;
       switch(play){
        case 0: ////////IGNORE GRAIN////////////
          break;
        default: ////////PLAY GRAIN////////////
        {
         float killVol = x->x_grain[g].g_killVol;
         switch(x->x_grain[g].g_direction){
           case -1: ////////////REVERSE////////////////
           {
             t_float windowShape = x->x_grain[g].g_wndShape;
             if(x->x_grain[g].g_startPos + x->x_grain[g].g_duration > maxIdBuf){
               x->x_grain[g].g_duration = maxIdBuf - x->x_grain[g].g_startPos;
             }
             t_int recDist = REV_REC_FADE;
             t_int volCorrection = 0;
             t_float volAdjustment = 1.0f;
              t_int layer = x->x_grain[g].g_playLayer;
              buf = x->x_bufPntr[layer];
               t_float index = x->x_grain[g].g_cPosGrain;  //start at the end of grain
               if(x->x_recordingState > 0){
                 int checkIndex = index + x->x_grain[g].g_startPos - x->x_recordingPos;
                 if (labs(checkIndex) < recDist){
                   recDist = checkIndex;
                   volCorrection = 1;
                 }
               }
               for(i=0; i<n; i++)
               {
                 if (index <= 3) {
                     x->x_grain[g].g_play = 0;
                 }
                 index -= x->x_grain[g].g_grainSpeed;
                 if(volCorrection > 0){
                   recDist -= x->x_grain[g].g_recDiffSpeed;
                   volAdjustment = (float)(labs(recDist)) / (float)(REV_REC_FADE);
                   volAdjustment = volAdjustment < 0.0f ? 0 : (volAdjustment > 1 ? 1 : volAdjustment);
                 }
                 t_sample tempVol = 0, tempVol2 = 0, tempL = 0, tempR = 0;
                 t_sample intpSampVal, intpSampVal2;
                 if (index > 3) {
                   int getVal = 0;
                   getVal = (int)index + x->x_grain[g].g_startPos;
                   wp = buf + (int)getVal;
                   intpSampVal = interpolate4(index - (int)index, wp[-2].w_float, wp[-1].w_float, wp[0].w_float, wp[1].w_float);
                   intpSampVal *= volRedFactor;
                   if(x->x_playStereo > 0){
                     wp2 = buf2 + (int)getVal;
                     intpSampVal2 = interpolate4(index - (int)index, wp2[-2].w_float, wp2[-1].w_float, wp2[0].w_float, wp2[1].w_float);
                     intpSampVal2 *= volRedFactor;
                   }
         
				   t_float indexWndFloat = (index * ((float)x->x_wndSize / (float)x->x_grain[g].g_duration))*x->x_grainSpacer;
                   int indexWnd = (int)indexWndFloat;
                   t_float indexWndDiff = indexWndFloat - indexWnd; // fixed bug 30/04/2022
                   indexWnd = indexWnd < 0 ? 0 : (indexWnd > WND_LENGTH ? WND_LENGTH : indexWnd);
                   t_float wndVal = getWndValIntp(indexWnd, windowShape, indexWndDiff);
                   if(x->x_playStereo > 0){
                     COMBINE_STEREO_GRAINS();
                   } else {
                     COMBINE_GRAINS();
                   }
                 }
                 OUTPUT_MIX();
               }
               x->x_grain[g].g_cPosGrain = index;
               break;
             }
           default: ////////////FORWARD////////////////
           {
             t_float windowShape = x->x_grain[g].g_wndShape;
             if(x->x_grain[g].g_startPos + x->x_grain[g].g_duration > maxIdBuf){
               x->x_grain[g].g_duration = maxIdBuf - x->x_grain[g].g_startPos;
             }
             t_int recDist = FWD_REC_FADE;
             t_int volCorrection = 0;
             t_float volAdjustment = 1.0f;
              t_int layer = x->x_grain[g].g_playLayer;
              buf = x->x_bufPntr[layer];
              buf2 = x->x_bufPntr[layer+noStBuf];
              t_float index = x->x_grain[g].g_cPosGrain;
              if(x->x_recordingState > 0){
                int checkIndex = index + x->x_grain[g].g_startPos - x->x_recordingPos;
                if (labs(checkIndex) < recDist){
                  recDist = checkIndex;
                  volCorrection = 1;
                }
              }
             for(i=0; i<n; i++)
               {
                 index += x->x_grain[g].g_grainSpeed;
                 if(volCorrection > 0){
                   volAdjustment = ((float)(labs(recDist)) / (float)(FWD_REC_FADE) * 1.1) - 0.1;
                   recDist++;
                   volAdjustment = volAdjustment < 0.0f ? 0 : (volAdjustment > 1 ? 1 : volAdjustment);
                 }
                 t_sample tempVol = 0, tempVol2 = 0, tempL = 0, tempR = 0;
                 t_sample intpSampVal, intpSampVal2;
                 if (index >= x->x_grain[g].g_duration) {
                   x->x_grain[g].g_play = 0;
                   tempL = 0; tempR = 0;
                 } else {
                   int getVal = (int)index + x->x_grain[g].g_startPos;;
                   wp = buf + (int)getVal;
                   intpSampVal = interpolate4(index - (int)index, wp[-1].w_float, wp[0].w_float, wp[1].w_float, wp[2].w_float);
                   intpSampVal *= volRedFactor;
                   if(x->x_playStereo > 0){
                     wp2 = buf2 + (int)getVal;
                     intpSampVal2 = interpolate4(index - (int)index, wp2[-1].w_float, wp2[0].w_float, wp2[1].w_float, wp2[2].w_float);
                     intpSampVal2 *= volRedFactor;
                   }
                   t_float indexWndFloat = (index * ((float)x->x_wndSize / (float)x->x_grain[g].g_duration))*x->x_grainSpacer;
                   int indexWnd = (int)indexWndFloat;
                   t_float indexWndDiff = indexWndFloat - indexWnd;
                   indexWnd = indexWnd > WND_LENGTH ? WND_LENGTH : indexWnd;
                   t_float wndVal = getWndValIntp(indexWnd, windowShape, indexWndDiff);
                   if(x->x_playStereo > 0){
                     COMBINE_STEREO_GRAINS();
                   } else {
                     COMBINE_GRAINS();
                   }
                 }
                 OUTPUT_MIX();
               }
               x->x_grain[g].g_cPosGrain = index;
               break;
             }
         }
         break;
        }
       }
     }
   }
   if (x->x_pTriggerVal != x->x_triggerVal){
     // outlet_float(x->x_trigger, (float)x->x_triggerVal);
     clock_set(x->x_clockTrigger, 0.f);
     x->x_pTriggerVal = x->x_triggerVal;
   }
  /* return a pointer to the dataspace for the next dsp-object */
  return (w+5);

  zero:
     while (n--) *out1++ = 0;
     while (n--) *out2++ = 0;
     return (w+5);
}


static void arbhar_play_tilde_set_layer(t_arbhar_play_tilde *x, t_symbol *s, t_float f)
{
    t_garray *a;
    t_int layer = (int)f;
    x->x_buffer[layer] = s;
    if (!(a = (t_garray *)pd_findbyclass(x->x_buffer[layer], garray_class))) {
        if (*s->s_name)
            pd_error(x, "arbhar_play~: %s: no such array", x->x_buffer[layer]->s_name);
        x->x_bufPntr[layer] = 0;
    } else if (!garray_getfloatwords(a, (int*)&x->x_bufSize[layer], &x->x_bufPntr[layer])) {
        pd_error(x, "%s: bad template for arbhar_play~", x->x_buffer[layer]->s_name);
        x->x_bufPntr[layer] = 0;
    } else garray_usedindsp(a);
}


static void arbhar_play_tilde_fire(t_arbhar_play_tilde *x, t_float f)
{
    int g = (int)f;
    if (g >= 0 && g < NO_OF_GRAINS) {
      x->x_grain[g].g_play = 1;
      x->x_grain[g].g_cPosGrain = 0;
      _setGrain(x, &x->x_grain[g], 1.0f);
      post("%d grain fired", g);
    }
    else
      post("%d outside available grain count", g);
}

static void arbhar_play_tilde_kill(t_arbhar_play_tilde *x, t_float f)
{
  int g = (int)f;
  if (x->x_grain[g].g_play == 0) {
    // post("%d is not playing", g);
  }
  else if (g >= 0 && g < NO_OF_GRAINS && x->x_grain[g].g_play > 0)  {
    // post("grain %d stopped.", g);
    x->x_grain[g].g_kill = 1;
    x->x_grain[g].g_killVol = 1.0f;
  } //else {
    //post("%d outside available grain count", g);
  //}
}

static void arbhar_play_tilde_kill_selected(t_arbhar_play_tilde *x, t_float f, t_float n)
{
  int gFirst = (int)f, gNo = (int)n, g = 0;
  for(int i = gFirst; i < gFirst + gNo; i++){
    g = i < NO_OF_GRAINS ? i : (i % NO_OF_GRAINS);
    if (x->x_grain[g].g_play > 0)  {
      x->x_grain[g].g_kill = 1;
      x->x_grain[g].g_killVol = 1.0f;
      post("%d will be killed", g);
    }
  }
}

