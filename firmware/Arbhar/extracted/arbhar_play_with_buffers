static t_float _calcGrainSpeedNew(t_arbhar_play_tilde *x){
  t_float qPitch = 1.0f;
  t_float rPitch = 1.0f;
  t_float vpoCV = _memread(x, 0, 2);
  t_float pitchPot = _memread(x, 0, 3);
  t_float pitch = _calcPitch(vpoCV, pitchPot);
  //post("pitch %f", pitch);
  //x->x_speed = pitch;
  if(x->x_qPitch > 0)
    qPitch = calcQuantisedPitch(x);
  if(x->x_rPitch > 0)
    rPitch = calcRandomPitch(x->x_rPitch);
  int chordPitches = _getChord(x);
  t_float chordPitch = 1.0f;
  if(x->x_polyphony > 0 && chordPitches > 0){
    static t_int getChordPitch = 0;
    if(x->x_pitchOrder > 0){
      getChordPitch++;
      getChordPitch = getChordPitch >= chordPitches ? 0 : getChordPitch;
    } else {
      getChordPitch = rand() % chordPitches;
    }
    chordPitch = _pitchToSpeed((t_float)x->x_polyPitches[getChordPitch]);
  }
  x->x_speed = pitch * qPitch * rPitch * chordPitch;
  return pitch * qPitch * rPitch * chordPitch;
}

