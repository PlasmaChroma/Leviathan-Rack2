if ( grep "/media/usb" /proc/mounts > /dev/null ) 
then
	echo "usb already mounted"
	return 0
else
	mount /dev/sda1 /media/usb
	if ( grep "/media/usb" /proc/mounts > /dev/null )
	then
		echo "usb drive at sda1 succesfully mounted"
		return 0
	else
		mount /dev/sdb1 /media/usb
		if ( grep "/media/usb" /proc/mounts > /dev/null )
		then 
			echo "usb drive at sdb1 succesfully mounted"
			return 0
		else
			mount /dev/sdc1 /media/usb
			if  ( grep "/media/usb" /proc/mounts > /dev/null )
			then
				echo "usb drive at sdc1 succesfully mounted"
				return 0
			else
				mount /dev/sdd1 /media/usb
				if ( grep "/media/usb" /proc/mounts > /dev/null )
				then
					echo "usb drive at sdd1 succesfully mounted"
					return 0
				else
					mount /dev/sde1 /media/usb
					if ( grep "/media/usb" /proc/mounts > /dev/null )
					then 
						echo "usb drive at sde1 succesfully mounted"
						return 0
					else
						mount /dev/sdf1 /media/usb
						if ( grep "/media/usb" /proc/mounts > /dev/null )
						then
							echo "usb drive at sdf1 succesfully mounted"
							return 0
						else
							echo "failed to mount usb"
							return 1
						fi
					fi
				fi
			fi
		fi
	fi
fi
