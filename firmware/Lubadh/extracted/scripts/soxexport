SAVE_DIR=/root/samples/save

echo "saving $1"

if [ "$1" == "Left" ]
then
    #left mono to to dual mono
    sox -r 49148 -e float -b 32 $SAVE_DIR/Left.raw $SAVE_DIR/Left.wav remix 1 1
    echo "saving left channel as dual mono file"
elif [ "$1" == "Right" ]
then
    #right mono to dual mono
    echo "saving right channel as dual mono file"
    sox -r 49148 -e float -b 32 $SAVE_DIR/Right.raw $SAVE_DIR/Right.wav remix 1 1
elif [ "$1" == "Linked" ]
then
    #make left input file stereo
    sox -r 49148 -e float -b 32 $SAVE_DIR/LinkedLeft.raw $SAVE_DIR/tempLeft.wav remix 1 0
    echo "making left input stereo"
    #make right input file stereo
    sox -r 49148 -e float -b 32 $SAVE_DIR/LinkedRight.raw $SAVE_DIR/tempRight.wav remix 0 1
    echo "making right input stereo"
    #mix left and right into stereo
    sox $SAVE_DIR/tempLeft.wav $SAVE_DIR/tempRight.wav -m $SAVE_DIR/Linked.wav
    echo "mixing inputs to output file"
    echo "tidying up"
    rm $SAVE_DIR/tempLeft.wav
    rm $SAVE_DIR/tempRight.wav
else
    #something went wrong
    echo "invalid option"
    exit 1
fi

# Get the most recent save name and increment it
sh scripts/mountusb
if ( grep "/media/usb" /proc/mounts > /dev/null )
then
    EXP_DIR=/media/usb/samples/saved
    # Ensure export directory exists
    mkdir -p $EXP_DIR

    # Read file names and add one to get new file name
    ls $EXP_DIR | grep ".wav" | sort -nr | cut -f1 -d. > $EXP_DIR/.files
    read -r LAST < $EXP_DIR/.files
    EXP_NAME=$((LAST+1)).wav

    echo "Exporting $1 as $EXP_NAME"
    cp $SAVE_DIR/$1.wav $EXP_DIR/$EXP_NAME

    sh scripts/unmountusb
else
    echo "No USB found, can't export file"
fi
